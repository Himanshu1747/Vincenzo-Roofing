{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/about/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/revalidate/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/send-contact/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/send-estimate/?$",
			"dest": "_render"
		},
		{
			"src": "^/blog/?$",
			"dest": "_render"
		},
		{
			"src": "^/blog(?:/(.*?))?/?$",
			"dest": "_render"
		},
		{
			"src": "^/contact/?$",
			"dest": "_render"
		},
		{
			"src": "^/free-estimate/?$",
			"dest": "_render"
		},
		{
			"src": "^/middleware/?$",
			"dest": "_render"
		},
		{
			"src": "^/rss\\.xml$",
			"dest": "_render"
		},
		{
			"src": "^/service/asphalt-shingle-roofing/?$",
			"dest": "_render"
		},
		{
			"src": "^/service/commercial-flat-roofing/?$",
			"dest": "_render"
		},
		{
			"src": "^/service/gutters-decks/?$",
			"dest": "_render"
		},
		{
			"src": "^/service/metal-roofing/?$",
			"dest": "_render"
		},
		{
			"src": "^/service/roof-inspection/?$",
			"dest": "_render"
		},
		{
			"src": "^/service/roof-repair/?$",
			"dest": "_render"
		},
		{
			"src": "^/service/roof-replacement/?$",
			"dest": "_render"
		},
		{
			"src": "^/service/siding-installation-replacement/?$",
			"dest": "_render"
		},
		{
			"src": "^/service/storm-emergency/?$",
			"dest": "_render"
		},
		{
			"src": "^/src/pages/api/send-estimate/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}