---
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import { queryWordPress } from "../../lib/wordpress";
import { SITE_DESCRIPTION } from "../../consts";

export async function getStaticPaths() {
    const data = await queryWordPress(`
        query ALLPROJECTS {
          myproject(first: 100) {
            nodes {
              id
              title
              content
              slug
              excerpt
              date
              featuredImage {
                node {
                  sourceUrl
                  altText
                  mediaDetails {
                    width
                    height
                    sizes {
                      name
                      sourceUrl
                      width
                      height
                    }
                  }
                }
              }
              allprojectsacf {
                galleryImage(first: 500) {
                  nodes {
                    altText
                    sourceUrl
                    mediaDetails {
                      sizes {
                        name
                        sourceUrl
                        width
                        height
                      }
                    }
                  }
                }
              }
            }
          }
        }
    `);

    const projects = data?.myproject?.nodes || [];

    return projects.map((post: any) => {
        const relatedPosts = projects
            .filter((p: any) => p.slug !== post.slug)
            .slice(0, 3);

        return {
            params: { slug: post.slug },
            props: { post, relatedPosts },
        };
    });
}

const { post, relatedPosts } = Astro.props;

if (!post) {
    return Astro.redirect("/404");
}

const galleryImages = post.allprojectsacf?.galleryImage?.nodes || [];

// Helper function to find Large image -> Medium image -> Original sourceUrl
function getImageUrls(imgNode: any) {
    const originalUrl = imgNode?.sourceUrl || "";
    const sizes = imgNode?.mediaDetails?.sizes || [];

    const largeObj = sizes.find((s: any) => s.name === "large");

    // Fall back to originalUrl if large does not exist, bypassing medium
    const displayUrl = largeObj?.sourceUrl || originalUrl;

    return {
        full: originalUrl,    // Original image for Lightbox modal
        display: displayUrl,  // Large -> Original for <img> thumbnail
    };
}
function formatDate(dateString: string) {
    if (!dateString) return "";
    return new Date(dateString).toLocaleDateString("en-US", {
        month: "short",
        day: "numeric",
        year: "numeric",
    });
}

function cleanExcerpt(excerpt: string) {
    if (!excerpt) return "";
    return excerpt.replace(/<[^>]*>?/gm, "").trim();
}

function truncateWords(text: string, wordLimit: number = 5) {
    if (!text) return "";
    const words = text.trim().split(/\s+/);
    if (words.length <= wordLimit) return text;
    return words.slice(0, wordLimit).join(" ") + "...";
}
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead
            title={`${post.title || "Vincenzo's Roofing"}`}
            description={cleanExcerpt(post.excerpt) || SITE_DESCRIPTION}
        />
        <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css"
        />
    </head>
    <body>
        <Header />

        <main id="top">
            <!-- Page Hero Header -->
            <section class="page-hero">
                <div class="container">
                    <div class="breadcrumb">
                        <a href="/">Home</a>
                        <span>/</span>
                        <a href="/projects">Projects</a>
                        <span>/</span>
                        <span title={post.title}
                            >{truncateWords(post.title, 5)}</span
                        >
                    </div>
                    <h1>
                        {post.title}
                    </h1>
                    <Fragment set:html={post.excerpt || ""} />
                </div>
            </section>

            <!-- Main Content & Sidebar Layout -->
            <div class="container article-layout">
                <!-- Single Article Content Column -->
                <div class="alldata">
                    <article>
                        {
                            post.featuredImage?.node?.sourceUrl && (
                                <div class="featured-cover-img">
                                    <img
                                        src={post.featuredImage.node.sourceUrl}
                                        alt={
                                            post.featuredImage.node.altText ||
                                            post.title
                                        }
                                    />
                                </div>
                            )
                        }

                        <!-- Dynamic WordPress Article Content -->
                        <div class="article-body">
                            <Fragment set:html={post.content || ""} />
                        </div>
                    </article>
                </div>

                <!-- Sidebar -->
                <aside class="sidebar">
                    <!-- Recent Articles Widget -->
                    <div class="sidebar-widget">
                        <h3>Explore Projects</h3>

                        {
                            relatedPosts.map((relPost: any) => (
                                <div
                                    class="recent-post-item"
                                    onclick={`window.location.href='/projects/${relPost.slug}'`}
                                    style="cursor: pointer;"
                                >
                                    <div class="recent-thumb">
                                        <img
                                            src={
                                                relPost.featuredImage?.node
                                                    ?.sourceUrl ||
                                                "https://staging2.vincenzoroofing.com/wp-content/uploads/2026/07/Best-Roofing-in-North-Hampton-NH-1-1.webp"
                                            }
                                            alt={
                                                relPost.featuredImage?.node
                                                    ?.altText || relPost.title
                                            }
                                        />
                                    </div>
                                    <div>
                                        <div class="recent-title">
                                            <a
                                                href={`/projects/${relPost.slug}`}
                                            >
                                                {relPost.title}
                                            </a>
                                        </div>
                                        <span class="recent-date">
                                            {formatDate(relPost.date)}
                                        </span>
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                </aside>
            </div>

            <!-- Dynamic ACF Gallery Section -->
            {
                galleryImages.length > 0 && (
                    <section class="gallery-sec">
                        <div class="container">
                            <div class="center-data">
                                <h2 class="titlenameees">
                                    {post.title || "Project Gallery"}
                                </h2>
                            </div>
                            <div class="gallery-grids">
                                {galleryImages.map((imgNode: any) => {
                                    const urls = getImageUrls(imgNode);
                                    return (
                                        <div class="gallery-image">
                                            <a
                                                href={urls.full}
                                                class="glightbox"
                                                data-gallery="fence-gallery"
                                            >
                                                <img
                                                    src={urls.display}
                                                    loading="lazy"
                                                    decoding="async"
                                                    alt={
                                                        imgNode.altText ||
                                                        "Gallery Image"
                                                    }
                                                />
                                            </a>
                                        </div>
                                    );
                                })}
                            </div>
                        </div>
                    </section>
                )
            }
        </main>

        <Footer />

        <style is:global>
            /* Single Post Header & Meta */
            .article-header {
                padding: 50px 0 40px;
                background: var(--off);
                border-bottom: 1px solid var(--line);
            }

            .post-badge-row {
                display: flex;
                align-items: center;
                gap: 12px;
                margin-bottom: 16px;
            }

            .post-cat {
                font-family: "Montserrat", sans-serif;
                background: var(--blue-pale);
                color: var(--blue);
                font-size: 11px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.1em;
                padding: 5px 14px;
                border-radius: 100px;
            }

            .post-read-time {
                font-size: 12.5px;
                color: var(--grey-light);
                font-family: "Montserrat", sans-serif;
                font-weight: 600;
            }

            .article-header h1 {
                font-size: clamp(28px, 4vw, 44px);
                line-height: 1.2;
                max-width: 900px;
                margin-bottom: 20px;
            }

            .post-author-meta {
                display: flex;
                align-items: center;
                gap: 14px;
                padding-top: 10px;
            }

            .author-avatar-lg {
                width: 44px;
                height: 44px;
                border-radius: 50%;
                background: var(--blue-bright);
                color: var(--white);
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
                font-family: "Montserrat", sans-serif;
                font-size: 16px;
            }

            .author-meta-info b {
                display: block;
                font-size: 14px;
                color: var(--ink);
            }

            .author-meta-info span {
                font-size: 12.5px;
                color: var(--grey-light);
            }

            h2.titlenameees {
                font-size: clamp(27px, 3.9vw, 40px);
                line-height: 1.14;
            }

            /* Article Grid Layout & Body Typography */
            .article-layout {
                display: grid;
                align-items: start;
                grid-template-columns: 1fr 340px;
                gap: 52px;
                padding: 60px 15px 80px;
            }

            .featured-cover-img {
                border-radius: var(--r-lg);
                overflow: hidden;
                margin-bottom: 40px;
                box-shadow: var(--sh-md);
                border: 1px solid var(--line);
            }

            .featured-cover-img img {
                width: 100%;
                object-fit: cover;
                display: block;
            }

            .article-body {
                font-size: 16.5px;
                line-height: 1.8;
                color: #2d3139;
            }

            .article-body p {
                margin-bottom: 24px;
            }

            .article-body h2 {
                font-size: clamp(22px, 2.8vw, 28px);
                margin: 42px 0 18px;
                line-height: 1.3;
            }

            .article-body h3 {
                font-size: 20px;
                margin: 32px 0 14px;
            }

            .article-body ul,
            .article-body ol {
                margin: 0 0 28px 20px;
            }

            .article-body ul li {
                list-style-type: disc;
                margin-bottom: 10px;
                padding-left: 6px;
            }

            .article-body ol li {
                list-style-type: decimal;
                margin-bottom: 10px;
                padding-left: 6px;
            }

            .article-body img {
                max-width: 100%;
                height: auto;
                border-radius: var(--r-md);
                margin: 20px 0;
            }

            /* Callout Boxes & Author Bio */
            .pull-quote {
                background: var(--blue-pale);
                border-left: 4px solid var(--blue);
                padding: 24px 28px;
                border-radius: 0 var(--r-md) var(--r-md) 0;
                margin: 36px 0;
                font-family: "Montserrat", sans-serif;
                font-size: 18px;
                font-weight: 700;
                color: var(--deep);
                line-height: 1.5;
            }

            .pro-tip-box {
                background: #fffdf3;
                border: 1.5px solid #f0e3a2;
                border-radius: var(--r-md);
                padding: 24px;
                margin: 36px 0;
            }

            .pro-tip-box h4 {
                color: #8c6a00;
                font-size: 15px;
                text-transform: uppercase;
                letter-spacing: 0.08em;
                margin-bottom: 8px;
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .pro-tip-box p {
                margin: 0;
                font-size: 15px;
                color: #4a3e10;
            }

            .author-bio-card {
                background: var(--off);
                border: 1px solid var(--line);
                border-radius: var(--r-lg);
                padding: 32px;
                display: flex;
                gap: 22px;
                align-items: center;
                margin-top: 50px;
            }

            .author-bio-card .bio-avatar {
                width: 70px;
                height: 70px;
                border-radius: 50%;
                background: var(--blue);
                color: var(--white);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 26px;
                font-weight: 700;
                flex-shrink: 0;
                font-family: "Montserrat", sans-serif;
            }

            .author-bio-card h4 {
                font-size: 17px;
                margin-bottom: 4px;
            }

            .author-bio-card p {
                font-size: 14px;
                color: var(--grey);
                margin: 0;
            }

            /* Sidebar Widgets & Form */
            .sidebar {
                display: flex;
                flex-direction: column;
                gap: 32px;
                position: sticky;
                top: 15%;
            }

            .sidebar-widget {
                background: var(--white);
                border: 1px solid var(--line);
                border-radius: var(--r-lg);
                padding: 28px;
                box-shadow: var(--sh-sm);
            }

            .sidebar-widget h3 {
                font-size: 17px;
                margin-bottom: 20px;
                padding-bottom: 12px;
                border-bottom: 2px solid var(--blue-pale);
                position: relative;
            }

            .sidebar-widget h3::after {
                content: "";
                position: absolute;
                bottom: -2px;
                left: 0;
                width: 40px;
                height: 2px;
                background: var(--blue);
            }

            .recent-post-item {
                display: flex;
                gap: 14px;
                margin-bottom: 18px;
                align-items: center;
                transition: transform 0.2s var(--ease);
            }

            .recent-post-item:hover {
                transform: translateX(4px);
            }

            table tr,
            table td,
            table th {
                border: 1px solid #000;
                padding: 10px;
            }
            .recent-post-item:last-child {
                margin-bottom: 0;
            }

            .recent-thumb {
                width: 68px;
                height: 68px;
                border-radius: var(--r-sm);
                overflow: hidden;
                flex-shrink: 0;
                background: var(--off);
            }

            .recent-thumb img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            .recent-title {
                font-family: "Montserrat", sans-serif;
                font-size: 13.5px;
                font-weight: 700;
                line-height: 1.35;
            }

            .recent-title a:hover {
                color: var(--blue);
            }
            section.page-hero h1 {
                padding-bottom: 15px;
            }

            .recent-date {
                font-size: 11.5px;
                color: var(--grey-light);
                margin-top: 4px;
                display: block;
            }

            /* Gallery Styles */
            .center-data {
                max-width: fit-content;
                margin: 0 auto;
                width: 100%;
                text-align: center;
            }
            .center-data .fs-40 {
                font-weight: 700;
            }
            .gallery-sec {
                padding: 85px 0px;
                background: #efefef;
            }
            .gallery-grids {
                display: grid;
                gap: 10px;
                grid-template-columns: repeat(4, minmax(0, 1fr));
                padding-top: 70px;
            }
            .gallery-image {
                height: 305px;
                overflow: hidden;
                max-width: 388px;
                width: 100%;
                margin: 0 auto;
                border-radius: 10px;
            }
            .gallery-image a {
                display: block;
                height: 100%;
                width: 100%;
            }
            .gallery-image img {
                height: 100%;
                width: 100%;
                object-fit: cover;
                object-position: center;
            }
            .gallery-grids .gallery-image:nth-child(1) {
                grid-column: span 2;
                grid-row: span 2;
                height: 626px;
                width: 100%;
                max-width: 100%;
            }

            /* Responsive Design */
            @media (max-width: 1600px) {
                .gallery-sec {
                    padding: 60px 0px;
                }
                .gallery-grids {
                    padding-top: 50px;
                }
            }
            @media (max-width: 1400px) {
                .gallery-sec {
                    padding: 40px 0px;
                }
                .gallery-grids {
                    padding-top: 30px;
                }
            }
            @media (max-width: 1199px) {
                .gallery-grids {
                    grid-template-columns: repeat(3, minmax(0, 1fr));
                }
            }
            @media (max-width: 1024px) {
                .article-layout {
                    grid-template-columns: 1fr;
                    gap: 40px;
                }
                .sidebar {
                    position: static;
                }
            }
            @media (max-width: 991px) {
                .gallery-grids .gallery-image:nth-child(1) {
                    grid-column: span 1;
                    grid-row: span 1;
                }
                .gallery-image,
                .gallery-grids .gallery-image:nth-child(1) {
                    height: 215px;
                    max-width: 388px;
                    width: 100%;
                    margin: 0 auto;
                }
            }
            @media (max-width: 767px) {
                .gallery-grids {
                    grid-template-columns: repeat(2, minmax(0, 1fr));
                }
                .gallery-sec {
                    padding: 30px 0px;
                }
            }
            @media (max-width: 575px) {
                .gallery-grids {
                    grid-template-columns: repeat(1, minmax(0, 1fr));
                }
                .gallery-image,
                .gallery-grids .gallery-image:nth-child(1) {
                    height: auto;
                }
            }
        </style>

        <script
            is:inline
            src="https://cdn.jsdelivr.net/npm/glightbox/dist/js/glightbox.min.js"
        ></script>

        <script is:inline>
            function setupLightbox() {
                if (window.lightboxInstance) {
                    window.lightboxInstance.destroy();
                }
                if (typeof GLightbox === "function") {
                    window.lightboxInstance = GLightbox({
                        selector: ".glightbox",
                        touchNavigation: true,
                        loop: true,
                    });
                }
            }

            document.addEventListener("DOMContentLoaded", setupLightbox);
            document.addEventListener("astro:page-load", setupLightbox);
        </script>
    </body>
</html>
