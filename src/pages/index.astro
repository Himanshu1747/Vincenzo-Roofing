---
export const prerender = false;

// Serve the cached page from the host's CDN for 90s, then refresh it in the
// background so WordPress edits (text/images) show up without a full site
// rebuild. See src/lib/wordpress.js for the data-fetching side.
Astro.response.headers.set(
    "Cache-Control",
    "public, max-age=0, s-maxage=90, stale-while-revalidate=30",
);

import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Contactform from "../components/Contactform.astro";
import { queryWordPress } from "../lib/wordpress";

const HOMEPAGE = `
query homepagedata {
  page(id: "/", idType: URI) {
    featuredImage {
      node {
        mediaItemUrl
        altText
      }
    }
    title
    content
    seo {
      canonical
      cornerstone
      fullHead
    }
  }
}
`;

const pagedata = await queryWordPress(HOMEPAGE);
const responsedata = pagedata?.page || {};
const seodata = responsedata?.seo || {};
---

