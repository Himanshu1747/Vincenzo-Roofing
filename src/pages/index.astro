        <script>
            document.addEventListener("DOMContentLoaded", () => {
                const contentImages = document.querySelectorAll("main img:not([loading])");
                contentImages.forEach((img) => {
                    img.setAttribute("loading", "lazy");
                    img.setAttribute("decoding", "async");
                });

                const marquee = document.getElementById("marquee");
                const marqueeWrap = document.querySelector(".marquee-wrap");

                if (!marquee || !marqueeWrap) return;

                const content = marquee.querySelector(".marquee-content");

                marquee.appendChild(content.cloneNode(true));
                marquee.appendChild(content.cloneNode(true));
                marquee.appendChild(content.cloneNode(true));

                marquee.style.willChange = "transform";

                let xPos = 0;
                const speedPerSecond = 30;
                let isPaused = false;
                let isVisible = true;
                let contentWidth = 0;
                let lastTimestamp = null;
                let rafId = null;

                const measure = () => {
                    contentWidth = content.offsetWidth;
                };
                measure();

                let resizeTimer;
                window.addEventListener("resize", () => {
                    clearTimeout(resizeTimer);
                    resizeTimer = setTimeout(measure, 150);
                });

                marqueeWrap.addEventListener("mouseenter", () => (isPaused = true));
                marqueeWrap.addEventListener("mouseleave", () => {
                    isPaused = false;
                    lastTimestamp = null;
                });

                const observer = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((entry) => {
                            isVisible = entry.isIntersecting;
                            if (isVisible && rafId === null) {
                                lastTimestamp = null;
                                rafId = requestAnimationFrame(animate);
                            }
                        });
                    },
                    { threshold: 0 },
                );
                observer.observe(marqueeWrap);

                document.addEventListener("visibilitychange", () => {
                    if (document.hidden) {
                        isPaused = true;
                    } else {
                        isPaused = false;
                        lastTimestamp = null;
                    }
                });

                function animate(timestamp) {
                    if (!isVisible) {
                        rafId = null;
                        return;
                    }

                    if (!isPaused) {
                        if (lastTimestamp === null) lastTimestamp = timestamp;
                        const delta = (timestamp - lastTimestamp) / 1000;
                        lastTimestamp = timestamp;

                        xPos -= speedPerSecond * delta;

                        if (Math.abs(xPos) >= contentWidth) {
                            xPos = 0;
                        }

                        marquee.style.transform = `translate3d(${xPos}px, 0, 0)`;
                    } else {
                        lastTimestamp = null;
                    }

                    rafId = requestAnimationFrame(animate);
                }

                rafId = requestAnimationFrame(animate);
            });
        </script>

        <script is:inline>
            document.addEventListener("DOMContentLoaded", () => {
                const faqButtons = document.querySelectorAll(".faq-q");

                faqButtons.forEach((button) => {
                    button.addEventListener("click", () => {
                        const currentItem = button.closest(".faq-item");

                        document.querySelectorAll(".faq-item").forEach((item) => {
                            if (item !== currentItem) {
                                item.classList.remove("open");
                            }
                        });

                        currentItem.classList.toggle("open");
                    });
                });
            });
        </script>
