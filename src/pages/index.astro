---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Testimonials from "../components/Testimonials.astro";
import Faqcompo from "../components/Faqcompo.astro";
import Contactform from "../components/Contactform.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { queryWordPress } from "../lib/wordpress";
import Contact from "./contact.astro";

const LOCATIONALL = `
query locationall {
  locationpost(first: 3) {
    nodes {
      slug
      title
      content
      featuredImage {
        node {
          sourceUrl
          altText
          mediaDetails {
            sizes {
              name
              sourceUrl
              width
              height
            }
          }
        }
      }
    }
  }
}
`;

const HOMEPAGE = `
query homepagedata {
  page(id: "/", idType: URI) {
    featuredImage {
      node {
        mediaItemUrl
        altText
      }
    }
    title
    content
    homepage {
      imageWaranty
      imageReview
      slidingText
      whatWeDoContent
      whyChooseContent
      whyChooseGrid {
        iconImage {
          node {
            mediaItemUrl
          }
        }
        gridData
      }
      whyVincenzoContent
      whyVincenzoList {
        vincenzoIcon {
          node {
            mediaItemUrl
          }
        }
        vincenzoDetails
      }
      whyVincenzoImage {
        node {
          mediaItemUrl
        }
      }
      localExpertisContents
      expertiseGrids{
        expertiseIcon{
          node{
            mediaItemUrl
          }
        }
        expertiseData
      }
      recentProjectsContent
      imageContent
      howWorkContent
      howWorkGrid {
        contentGridSteps
      }
      allTimeAvaialbelData
      faqHomeContents
      finalCtaData
      serviceAreaContent
      testimonialContents
      allAreas{
        areaPageLinks{
          url
        }
        areaName
      }
      exploreAllAreas{
        url
        title
      }
      whatWeDoGrids{
        whatIconImage{
          node{
            mediaItemUrl
          }
        }
        serviceName
        serviceIntro
        serviceLink{
          url
          title
        }
      }
    }
  }
}
`;

// PERF: these two queries don't depend on each other, so fire them together
// instead of awaiting one after the other. This is usually the single
// biggest win on a WordPress-backed Astro page — you were paying for two
// sequential network round-trips on every request/build.
const [postdata, pagedata] = await Promise.all([
    queryWordPress(LOCATIONALL),
    queryWordPress(HOMEPAGE),
]);

const postrespons = postdata?.locationpost?.nodes || [];
const responsedata = pagedata?.page || {};
const rawServices = pagedata?.services?.nodes || [];

// Target custom ordering based on desired service sequence
const desiredOrder = [
    "roof-replacement",
    "roof-repair",
    "storm-emergency-response",
    "roof-inspection",
    "asphalt-shingle-roofing",
    "metal-roofing",
    "commercial-flat-roofing",
    "siding-installation-replacement",
    "gutters-siding",
];

// Sort nodes according to the custom array sequence above
const servicesData = rawServices.sort((a, b) => {
    const indexA = desiredOrder.indexOf(a.slug);
    const indexB = desiredOrder.indexOf(b.slug);

    const rankA = indexA === -1 ? 999 : indexA;
    const rankB = indexB === -1 ? 999 : indexB;

    return rankA - rankB;
});

// PERF: build a srcset from the WP-generated image sizes you were already
// fetching (mediaDetails.sizes) but never using. Without this, every
// gallery card was downloading the full-resolution original even though
// it renders at 434x289 — on a typical WP media library that's often
// 3-10x more bytes than needed, on every single card, on every visit.
function buildSrcSet(sizes) {
    if (!sizes || !sizes.length) return undefined;
    return sizes
        .filter((s) => s?.sourceUrl && s?.width)
        .map((s) => `${s.sourceUrl} ${s.width}w`)
        .join(", ");
}
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <Header />
        <main id="top">
            <!-- Hero -->
            <section class="hero">
                <div class="hero-grid-tex" aria-hidden="true"></div>
                <div class="container hero-inner">
                    <div class="hero-copy">
                        <Fragment set:html={responsedata?.content || "error"} />
                    </div>

                    <div class="hero-visual">
                        <div class="hero-card">
                            <img
                                src={responsedata?.featuredImage?.node
                                    ?.mediaItemUrl || "error"}
                                alt="Vincenzo’s Roofing"
                                width="615"
                                height="460"
                                fetchpriority="high"
                                loading="eager"
                                decoding="async"
                            />
                        </div>
                        <div class="hero-float warranty">
                            <div class="ic">
                                <svg
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    ><path
                                        d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z"
                                    ></path><path d="M9 12l2 2 4-4"></path></svg
                                >
                            </div>
                            <div
                                class="warnaty-box"
                                set:html={responsedata?.homepage
                                    ?.imageWaranty || "error"}
                            />
                        </div>
                        <div
                            class="hero-float review"
                            set:html={responsedata?.homepage?.imageReview ||
                                "error"}
                        />
                    </div>
                </div>
            </section>

            <!-- Marquee trust bar -->

            <div class="marquee-wrap" aria-hidden="true">
                <div class="marquee" id="marquee">
                    <p class="marquee-content">
                        {responsedata?.homepage?.slidingText || "error"}
                    </p>
                </div>
            </div>

            <!-- Services -->
            <section class="section svc-section" id="services">
                <div class="container">
                    <div
                        class="sec-header"
                        set:html={responsedata?.homepage?.whatWeDoContent ||
                            "error"}
                    />
                    <div class="svc-grid">
                        {
                            responsedata?.homepage?.whatWeDoGrids?.map(
                                (svcItem, index) => (
                                    <div class={`svc-card ${index < 2 ? 'feature ' : ''}reveal`}>
                                        <span class="svc-num">{String(index + 1).padStart(2, "0")}</span>
                                        <div class="svc-icon">
                                            <img
                                                src={svcItem?.whatIconImage?.node?.mediaItemUrl || "error"}
                                                width="23"
                                                height="23"
                                                loading="lazy"
                                                decoding="async"
                                                alt={svcItem?.serviceName || "Service"}
                                            />
                                        </div>
                                        <h3>{svcItem?.serviceName || "error"}</h3>
                                        <div set:html={svcItem?.serviceIntro || "error"} />
                                        <a
                                            class="svc-arrow"
                                            href={svcItem?.serviceLink?.url || "#"}
                                        >
                                            {svcItem?.serviceLink?.title || "Explore Now"}
                                        </a>
                                    </div>
                                )
                            )
                        }
                    </div>
                </div>
            </section>
            <section class="section weather-section" id="nh-weather">
                <div class="container">
                    <div
                        class="sec-header"
                        set:html={responsedata?.homepage
                            ?.localExpertisContents || "error"}
                    />
                    <div class="weather-grid">
                        {
                            responsedata?.homepage?.expertiseGrids.map(
                                (items) => (
                                    <div class="weather-card reveal">
                                        <div class="weather-icon">
                                            <img
                                                src={
                                                    items?.expertiseIcon?.node
                                                        ?.mediaItemUrl ||
                                                    "error"
                                                }
                                                alt=""
                                                height="23"
                                                width="23"
                                                loading="lazy"
                                            />
                                        </div>
                                        <Fragment
                                            set:html={
                                                items?.expertiseData || "error"
                                            }
                                        />
                                    </div>
                                ),
                            )
                        }
                    </div>
                </div>
            </section>
            <!-- Why Choose Us (Unique Layout) -->
            <section class="section" id="why-choose-us">
                <div class="container">
                    <div
                        class="sec-header"
                        set:html={responsedata?.homepage?.whyChooseContent ||
                            "error"}
                    />

                    <div class="wcu-grid">
                        {
                            responsedata?.homepage?.whyChooseGrid.map(
                                (chooseitems) => (
                                    <div class="wcu-card reveal">
                                        <div class="wcu-icon">
                                            <img
                                                src={
                                                    chooseitems?.iconImage?.node
                                                        ?.mediaItemUrl ||
                                                    "error"
                                                }
                                                alt="icon-image"
                                                width="24"
                                                height="24"
                                                loading="lazy"
                                                decoding="async"
                                            />
                                        </div>
                                        <Fragment
                                            set:html={
                                                chooseitems?.gridData || "error"
                                            }
                                        />
                                    </div>
                                ),
                            )
                        }
                    </div>
                </div>
            </section>

            <section class="section" id="why">
                <div class="container why-wrap">
                    <div class="why-visual reveal">
                        <div class="frame">
                            <img
                                src={responsedata?.homepage?.whyVincenzoImage
                                    ?.node?.mediaItemUrl || "error"}
                                alt="Why Vincenzo’s"
                                loading="lazy"
                                decoding="async"
                                width="617"
                                height="462"
                            />
                        </div>
                        <div
                            class="why-chip"
                            set:html={responsedata?.homepage?.imageContent ||
                                "error"}
                        />
                    </div>
                    <div>
                        <Fragment
                            set:html={responsedata?.homepage
                                ?.whyVincenzoContent || "error"}
                        />
                        <div class="why-list">
                            {
                                responsedata?.homepage?.whyVincenzoList.map(
                                    (vincenzoitems) => (
                                        <div class="why-item reveal">
                                            <div class="why-icon">
                                                <img
                                                    src={
                                                        vincenzoitems
                                                            ?.vincenzoIcon?.node
                                                            ?.mediaItemUrl ||
                                                        "error"
                                                    }
                                                    alt="icon"
                                                    height="20"
                                                    width="20"
                                                    loading="lazy"
                                                    decoding="async"
                                                />
                                            </div>
                                            <div>
                                                <Fragment
                                                    set:html={
                                                        vincenzoitems?.vincenzoDetails ||
                                                        "error"
                                                    }
                                                />
                                            </div>
                                        </div>
                                    ),
                                )
                            }
                        </div>
                    </div>
                </div>
            </section>

            <!-- Process -->
            <section class="section process" id="process">
                <div class="container">
                    <div
                        class="sec-header"
                        set:html={responsedata?.homepage?.howWorkContent ||
                            "error"}
                    />
                    <div class="process-grid">
                        {
                            responsedata?.homepage?.howWorkGrid?.map(
                                (whyitems, index) => (
                                    <div class="p-step reveal">
                                        <span class="p-num">
                                            Step{" "}
                                            {String(index + 1).padStart(2, "0")}
                                        </span>
                                        <Fragment
                                            set:html={
                                                whyitems?.contentGridSteps ||
                                                "error"
                                            }
                                        />
                                    </div>
                                ),
                            )
                        }
                    </div>
                </div>
            </section>

            <!-- Gallery -->
            <section class="section" id="gallery">
                <div class="container">
                    <div
                        class="sec-header"
                        set:html={responsedata?.homepage
                            ?.recentProjectsContent || "error"}
                    />
                    <div class="gallery-masonry">
                        {
                            postrespons?.map((postitems) => {
                                const sizes =
                                    postitems?.featuredImage?.node?.mediaDetails
                                        ?.sizes;
                                const srcset = buildSrcSet(sizes);
                                return (
                                    <a
                                        href="javascript:void(0)"
                                        class="photo-frame"
                                        data-cat="residential"
                                    >
                                    {/* <a
                                        href={`/location/${postitems.slug}`}
                                        class="photo-frame"
                                        data-cat="residential"
                                    > */}
                                        <img
                                            src={
                                                postitems?.featuredImage?.node
                                                    ?.sourceUrl ||
                                                "/placeholder.jpg"
                                            }
                                            srcset={srcset}
                                            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 434px"
                                            alt={postitems?.title}
                                            width="434"
                                            height="289"
                                            loading="lazy"
                                            decoding="async"
                                        />
                                        <div class="g-cap">
                                            {postitems?.title}
                                        </div>
                                    </a>
                                );
                            })
                        }
                    </div>
                    <!-- <p class="note">
                        Illustrative placeholders — swap in real project
                        photography before launch.
                    </p> -->
                </div>
            </section>

            <!-- Testimonials -->
            <!-- <section class="section testi">
                <div class="container">
                    <div
                        class="sec-header"
                        set:html={responsedata?.homepage?.testimonialContents ||
                            "error"}
                    />
                    <Testimonials />
                    <p class="note">
                        Placeholder testimonials for layout — replace with
                        verified Google reviews before launch.
                    </p>
                </div>
            </section> -->

            <section class="emergency">
                <div
                    class="container"
                    set:html={responsedata?.homepage?.allTimeAvaialbelData ||
                        "error"}
                />
            </section>

            <!-- Areas -->
            <section class="section" id="areas" style="background: #F6F7F9;">
                <div class="container areas-wrap">
                    <div>
                        <Fragment
                            set:html={responsedata?.homepage
                                ?.serviceAreaContent || "error"}
                        />

                        <div class="area-chips">
                            {
                                responsedata?.homepage?.allAreas?.map(
                                    (locationitems) => (
                                        <a
                                            class="area-chip"
                                            title={
                                                locationitems?.areaName ||
                                                "error"
                                            }
                                            href={
                                                locationitems?.areaPageLinks
                                                    ?.url || "error"
                                            }
                                        >
                                            {locationitems?.areaName || "error"}
                                        </a>
                                    ),
                                )
                            }
                        </div>
                        <a
                            href={responsedata?.homepage?.exploreAllAreas
                                ?.url || "error"}
                            class="btn btn-blue"
                            style="margin-top: 25px;"
                            >{
                                responsedata?.homepage?.exploreAllAreas
                                    ?.title || "error"
                            }</a
                        >
                    </div>
                    <div class="map-frame reveal">
                        <svg
                            viewBox="0 0 520 430"
                            xmlns="http://www.w3.org/2000/svg"
                        >
                            <rect width="520" height="430" fill="#071F45"
                            ></rect>
                            <path
                                d="M160 30 L355 62 L335 168 L378 232 L346 360 L188 392 L126 274 L94 126 Z"
                                fill="#0E2B5B"
                                stroke="#0D47A1"
                                stroke-width="2.5"></path>
                            <g fill="#4A7FD4"
                                ><circle cx="210" cy="190" r="6"
                                ></circle><circle cx="252" cy="232" r="6"
                                ></circle><circle cx="190" cy="105" r="6"
                                ></circle><circle cx="272" cy="315" r="6"
                                ></circle><circle cx="318" cy="210" r="6"
                                ></circle></g
                            >
                            <g
                                fill="none"
                                stroke="#4A7FD4"
                                stroke-opacity="0.35"
                                stroke-width="1.4"
                            >
                                <circle cx="210" cy="190" r="14"
                                ></circle><circle cx="252" cy="232" r="14"
                                ></circle><circle cx="190" cy="105" r="14"
                                ></circle><circle cx="272" cy="315" r="14"
                                ></circle><circle cx="318" cy="210" r="14"
                                ></circle>
                            </g>
                            <text
                                x="260"
                                y="416"
                                fill="#7A8FB4"
                                font-family="Montserrat,sans-serif"
                                font-weight="600"
                                font-size="11"
                                text-anchor="middle"
                                letter-spacing="2"
                                >SERVING ALL OF NEW HAMPSHIRE</text
                            >
                        </svg>
                    </div>
                </div>
            </section>

            <!-- FAQ -->
            <section class="section" id="faq">
                <div class="container">
                    <div
                        class="sec-header"
                        style="text-align:center; margin:0 auto 40px;"
                        set:html={responsedata?.homepage?.faqHomeContents ||
                            "error"}
                    />
                    <Faqcompo />
                </div>
            </section>

            <!-- CTA band -->
            <section class="cta-band">
                <div
                    class="cta-inner"
                    set:html={responsedata?.homepage?.finalCtaData || "error"}
                />
            </section>

            <!-- Contact -->
            <Contactform />
        </main>

        <Footer />
        <script>
            document.addEventListener("DOMContentLoaded", () => {
                // Any images injected from WordPress rich text (set:html blocks
                // like whatWeDoContent, whyChooseContent, etc.) skip our manual
                // loading="lazy" attributes entirely. Catch them here so they
                // don't all fight for bandwidth on initial load.
                const contentImages = document.querySelectorAll(
                    "main img:not([loading])",
                );
                contentImages.forEach((img) => {
                    img.setAttribute("loading", "lazy");
                    img.setAttribute("decoding", "async");
                });

                const marquee = document.getElementById("marquee");
                const marqueeWrap = document.querySelector(".marquee-wrap");

                if (!marquee || !marqueeWrap) return;

                const content = marquee.querySelector(".marquee-content");

                // Clone the p tag multiple times to ensure it covers wide screens
                marquee.appendChild(content.cloneNode(true));
                marquee.appendChild(content.cloneNode(true));
                marquee.appendChild(content.cloneNode(true));

                // Promote to its own compositor layer so the transform is
                // handled on the GPU instead of triggering paint/layout.
                marquee.style.willChange = "transform";

                let xPos = 0;
                // TWEAK THIS NUMBER TO CHANGE SPEED (pixels per second)
                const speedPerSecond = 30;
                let isPaused = false;
                let isVisible = true;
                let contentWidth = 0;
                let lastTimestamp = null;
                let rafId = null;

                // Measure width ONCE (and again on resize, debounced) instead
                // of reading offsetWidth every animation frame — that was
                // forcing a synchronous layout recalculation ~60x/sec and was
                // the main cause of jank/slowness.
                const measure = () => {
                    contentWidth = content.offsetWidth;
                };
                measure();

                let resizeTimer;
                window.addEventListener("resize", () => {
                    clearTimeout(resizeTimer);
                    resizeTimer = setTimeout(measure, 150);
                });

                // Pause on hover
                marqueeWrap.addEventListener(
                    "mouseenter",
                    () => (isPaused = true),
                );
                marqueeWrap.addEventListener("mouseleave", () => {
                    isPaused = false;
                    lastTimestamp = null;
                });

                // Fully stop the rAF loop when the marquee scrolls off-screen
                // instead of animating an invisible element forever.
                const observer = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((entry) => {
                            isVisible = entry.isIntersecting;
                            if (isVisible && rafId === null) {
                                lastTimestamp = null;
                                rafId = requestAnimationFrame(animate);
                            }
                        });
                    },
                    { threshold: 0 },
                );
                observer.observe(marqueeWrap);

                // Pause when the browser tab isn't active (saves battery/CPU)
                document.addEventListener("visibilitychange", () => {
                    if (document.hidden) {
                        isPaused = true;
                    } else {
                        isPaused = false;
                        lastTimestamp = null;
                    }
                });

                function animate(timestamp) {
                    if (!isVisible) {
                        rafId = null;
                        return;
                    }

                    if (!isPaused) {
                        if (lastTimestamp === null) lastTimestamp = timestamp;
                        const delta = (timestamp - lastTimestamp) / 1000;
                        lastTimestamp = timestamp;

                        xPos -= speedPerSecond * delta;

                        // Instantly snap back to 0 when one full p tag has scrolled by
                        if (Math.abs(xPos) >= contentWidth) {
                            xPos = 0;
                        }

                        marquee.style.transform = `translate3d(${xPos}px, 0, 0)`;
                    } else {
                        lastTimestamp = null;
                    }

                    rafId = requestAnimationFrame(animate);
                }

                rafId = requestAnimationFrame(animate);
            });
        </script>
    </body>
</html>