---
import BaseHead from "../components/BaseHead.astro";
import Contactform from "../components/Contactform.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { queryWordPress } from "../lib/wordpress";

const PAGEJSON = `
query homepagedata {
  page(id: "/contact", idType: URI) {
    title
    content
    contactpage{
      vincenzosRoofingLlcGrid{
        socialImage{
          node{
            mediaItemUrl
          }
        }
        socialContent
      }
      finalCtaContent
    }

  }
}
`;
const pagedata = await queryWordPress(PAGEJSON);
const alldata = pagedata?.page;
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <Header />

        <main id="top">
            <!-- ============ HERO ============ -->
            <section class="page-hero">
                <div class="container">
                    <div class="breadcrumb">
                        <a href="../index.html">Home</a>
                        <span>/</span>
                        <span style="color:#fff;">Contact</span>
                    </div>
                    <Fragment set:html={alldata?.content || "error"} />
                </div>
            </section>

            <!-- ============ CONTACT SECTION ============ -->
            <Contactform />

            <!-- Emergency / Final CTA -->
           
            <section class="cta-band">
                <div class="cta-inner">
                    <div class="center-ctas" set:html={alldata?.contactpage?.finalCtaContent || "error"}>
                        
                    </div>
                </div>
            </section>
        </main>

        <Footer />

        <style is:global>
            .err {
                display: block;
                color: #c0392b;
                font-size: 12px;
                margin-top: 4px;
                min-height: 14px;
            }
            .field-invalid {
                border-color: #c0392b !important;
            }
            .cta-inner::before{
                z-index: -1;
            }
            a.btn.btn-white{
                margin-top: 20px;
            }
            .form-status {
                padding: 12px 14px;
                border-radius: var(--r-sm, 12px);
                font-size: 14px;
                margin-bottom: 16px;
            }
            .form-status.success {
                background: #e9f7ef;
                color: #1e7e34;
                border: 1px solid #c3e6cb;
            }
            .form-status.error {
                background: #fdecea;
                color: #c0392b;
                border: 1px solid #f5c6cb;
            }
        </style>
    </body>
</html>
