---
export const prerender = false;

// Serve the cached page from the host's CDN for 90s, then refresh it in the
// background so WordPress edits (text/images) show up without a full site
// rebuild. See src/lib/wordpress.js for the data-fetching side.
Astro.response.headers.set(
    "Cache-Control",
    "public, max-age=0, s-maxage=90, stale-while-revalidate=30",
);
import BaseHead from "../components/BaseHead.astro";
import Contactform from "../components/Contactform.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { queryWordPress } from "../lib/wordpress";

const PAGEJSON = `
query homepagedata {
  page(id: "/contact", idType: URI) {
    title
    content
    seo {
      canonical
      cornerstone
      fullHead
    }
    contactPage{
      contactFormSecData
      vincenzosRoofingLlcTitle
      vincenzosRoofingLlcGridLists{
        vincenzosRoofingLlcIconImage{
          node{
            mediaItemUrl
          }
        }
        vincenzosRoofingLlcGristContent
      }
      finalCtaSecContent
    }
  }
}
`;
const pagedata = await queryWordPress(PAGEJSON);
const alldata = pagedata?.page;
const seodata = alldata?.seo || {};
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead
            useYoast={true}
            canonical={seodata?.canonical || ""}
            focuskw={seodata?.focuskw || ""}
        />
        {seodata?.fullHead && <Fragment set:html={seodata.fullHead} />}
    </head>
    <body>
        <Header />

        <main id="top">
            <!-- ============ HERO ============ -->
            <section class="page-hero">
                <div class="hero-grid-tex" aria-hidden="true"></div>
                <div class="container">
                    <div class="breadcrumb">
                        <a href="/">Home</a><span>/</span><span
                            style="color:#fff;">Contact</span
                        >
                    </div>
                    <Fragment set:html={alldata?.content || "error"}/>
                </div>
            </section>

            <!-- ============ CONTACT SECTION ============ -->
            <Contactform />

            <!-- Emergency / Final CTA -->

            <section class="cta-band">
                <div class="cta-inner">
                    <Fragment set:html={alldata?.contactPage?.finalCtaSecContent || "error"}/>
                </div>
            </section>
        </main>

        <Footer />

        <style is:global>
            .err {
                display: block;
                color: #c0392b;
                font-size: 12px;
                margin-top: 4px;
                min-height: 14px;
            }
            .field-invalid {
                border-color: #c0392b !important;
            }
            .cta-inner::before {
                z-index: -1;
            }
            a.btn.btn-white {
                margin-top: 20px;
            }
            .form-status {
                padding: 12px 14px;
                border-radius: var(--r-sm, 12px);
                font-size: 14px;
                margin-bottom: 16px;
            }
            .form-status.success {
                background: #e9f7ef;
                color: #1e7e34;
                border: 1px solid #c3e6cb;
            }
            .form-status.error {
                background: #fdecea;
                color: #c0392b;
                border: 1px solid #f5c6cb;
            }
        </style>
    </body>
</html>
