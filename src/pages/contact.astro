---
import BaseHead from "../components/BaseHead.astro";
import Contactform from "../components/Contactform.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { queryWordPress } from "../lib/wordpress";

const PAGEJSON = `
query homepagedata {
  page(id: "/contact", idType: URI) {
    title
    content
    contactpage{
      vincenzosRoofingLlcGrid{
        socialImage{
          node{
            mediaItemUrl
          }
        }
        socialContent
      }
      finalCtaContent
    }

  }
}
`;
const pagedata = await queryWordPress(PAGEJSON);
const alldata = pagedata?.page;
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <Header />

        <main id="top">
            <!-- ============ HERO ============ -->
            <section class="page-hero">
                <div class="container">
                    <div class="breadcrumb">
                        <a href="../index.html">Home</a>
                        <span>/</span>
                        <span style="color:#fff;">Contact</span>
                    </div>
                    <Fragment set:html={alldata?.content || "error"} />
                </div>
            </section>

            <!-- ============ CONTACT SECTION ============ -->
        <Contactform/>

            <!-- Emergency / Final CTA -->
            <section class="emergency">
                <div
                    class="container"
                    set:html={alldata?.contactpage?.finalCtaContent || "error"}
                />
            </section>
        </main>

        <Footer />



        <style>
            .err {
                display: block;
                color: #C0392B;
                font-size: 12px;
                margin-top: 4px;
                min-height: 14px;
            }
            .field-invalid {
                border-color: #C0392B !important;
            }
            .form-status {
                padding: 12px 14px;
                border-radius: var(--r-sm, 12px);
                font-size: 14px;
                margin-bottom: 16px;
            }
            .form-status.success {
                background: #E9F7EF;
                color: #1E7E34;
                border: 1px solid #C3E6CB;
            }
            .form-status.error {
                background: #FDECEA;
                color: #C0392B;
                border: 1px solid #F5C6CB;
            }
        </style>
    </body>
</html>