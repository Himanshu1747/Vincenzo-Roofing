---
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import { queryWordPress } from "../../lib/wordpress";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";

// NOTE: no "first" limit here, so this pulls every service (title, slug,
// featured image, icon, intro) in one query. Fine if the service count is
// small and stable — add a "first: N" (like the homepage does) if this
// list is likely to grow a lot.
const SERVICEDATA = `
query AllServices {
  services {
    nodes {
      title
      slug

      # Featured Image query
      featuredImage {
        node {
          sourceUrl
        }
      }

      # Custom ACF/Field Group
      servicespost {
        iconImage {
          node {
            mediaItemUrl
          }
        }

        shortIntro
      }
    }
  }
}
`;

const SERVIMAINPAGE = `
query servicedata {
  page(id: "/service", idType: URI) {
    title
    content
    servicePage {
      ctaContents
    }
  }
}
`;

// SERVICEDATA and SERVIMAINPAGE are independent queries — fire them in
// parallel instead of one after another so the page only waits as long
// as the slower of the two, not the sum of both.
const [pagedata, mainpag] = await Promise.all([
  queryWordPress(SERVICEDATA),
  queryWordPress(SERVIMAINPAGE),
]);

const rawServices = pagedata?.services?.nodes || [];
const respopage = mainpag?.page;

// Desired order by slug matching your required sequence:
const desiredOrder = [
  "roof-replacement",
  "roof-repair",
  "storm-emergency-response",
  "roof-inspection",
  "asphalt-shingle-roofing",
  "metal-roofing",
  "commercial-flat-roofing",
  "siding-installation-replacement",
  "gutters-siding",
];

// Sort nodes according to the custom array sequence above
const responsedata = rawServices.sort((a, b) => {
  const indexA = desiredOrder.indexOf(a.slug);
  const indexB = desiredOrder.indexOf(b.slug);
  
  const rankA = indexA === -1 ? 999 : indexA;
  const rankB = indexB === -1 ? 999 : indexB;
  
  return rankA - rankB;
});
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />

    <main id="top">
      <section class="page-hero">
        <div class="container">
          <div class="breadcrumb">
            <a href="/">Home</a>
            <span>/</span>
            <span style="color:#fff;">Services</span>
          </div>
          <Fragment set:html={respopage?.content || "error"} />
        </div>
      </section>

      <!-- Detail rows -->
      <section class="section">
        <div class="container">
          {
            responsedata.map((servotems, index) => (
              <div class="svc-detail-row" id={servotems.slug}>
                <div class="photo-frame ratio-4-3 reveal">
                  <img
                    src={
                      servotems?.featuredImage?.node?.sourceUrl ||
                      "https://staging2.vincenzoroofing.com/wp-content/uploads/2026/07/photo-1600585154340-be6161a56a0c.webp"
                    }
                    alt={servotems.title}
                    width="644"
                    height="483"
                    loading={index === 0 ? "eager" : "lazy"}
                    decoding="async"
                    fetchpriority={index === 0 ? "high" : "auto"}
                  />
                </div>
                <div class="svc-detail-copy reveal">
                  {servotems?.servicespost?.iconImage?.node?.mediaItemUrl && (
                    <div class="svc-icon">
                      <img
                        src={servotems.servicespost.iconImage.node.mediaItemUrl}
                        alt={servotems.title}
                        width="23"
                        height="23"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  )}
                  <h3>{servotems.title}</h3>
                  {servotems?.servicespost?.shortIntro && (
                    <div set:html={servotems.servicespost.shortIntro} />
                  )}

                  <a href={`/service/${servotems.slug}`} class="btn btn-blue">
                    View Details
                  </a>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- CTA band -->
      <section class="cta-band">
        <div
          class="cta-inner"
          set:html={respopage?.servicePage?.ctaContents || "error"}
        />
      </section>
    </main>

    <Footer />
  </body>
</html>