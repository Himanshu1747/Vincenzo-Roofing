---
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import { queryWordPress } from "../../lib/wordpress";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";

const SERVICEDATA = `
query AllServices {
  services {
    nodes {
      title
      slug

      # Featured Image query
      featuredImage {
        node {
          sourceUrl
        }
      }

      # Custom ACF/Field Group
      servicespost {
        iconImage {
          node {
            mediaItemUrl
          }
        }

        shortIntro
      }
    }
  }
}
`;

const pagedata = await queryWordPress(SERVICEDATA);
const responsedata = pagedata?.services?.nodes || [];

const SERVIMAINPAGE = `

query servicedata {
  page(id: "/service", idType: URI) {
    title
    content
servicePage{
  ctaContents
}
  }
}

`;
const mainpag = await queryWordPress(SERVIMAINPAGE);
const respopage = mainpag?.page;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />

    <main id="top">
      <section class="page-hero">
        <div class="container">
          <div class="breadcrumb">
            <a href="/">Home</a>
            <span>/</span>
            <span style="color:#fff;">Services</span>
          </div>
          <Fragment set:html={respopage?.content || "error"} />
        </div>
      </section>

      <!-- Detail rows -->
      <section class="section">
        <div class="container">
          {
            responsedata.map((servotems, index) => (
              <div class="svc-detail-row" id={servotems.slug}>
                <div class="photo-frame ratio-4-3 reveal">
                  <img
                    src={
                      servotems?.featuredImage?.node?.sourceUrl ||
                      "https://staging2.vincenzoroofing.com/wp-content/uploads/2026/07/photo-1600585154340-be6161a56a0c.webp"
                    }
                    alt={servotems.title}
                    width="644"
                    height="483"
                    loading={index === 0 ? "eager" : "lazy"}
                    decoding="async"
                    fetchpriority={index === 0 ? "high" : "auto"}
                  />
                </div>
                <div class="svc-detail-copy reveal">
                  {servotems?.servicespost?.iconImage?.node?.mediaItemUrl && (
                    <div class="svc-icon">
                      <img
                        src={servotems.servicespost.iconImage.node.mediaItemUrl}
                        alt={servotems.title}
                        width="23"
                        height="23"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  )}
                  <h3>{servotems.title}</h3>
                  {servotems?.servicespost?.shortIntro && (
                    <div set:html={servotems.servicespost.shortIntro} />
                  )}

                  <a href={`/service/${servotems.slug}`} class="btn btn-blue">
                    View Details
                  </a>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- CTA band -->
      <section class="cta-band">
        <div
          class="cta-inner"
          set:html={respopage?.servicePage?.ctaContents || "error"}
        />
      </section>
    </main>

    <Footer />
  </body>
</html>
