---
import BaseHead from "../../components/BaseHead.astro";
import Contactform from "../../components/Contactform.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import { queryWordPress } from "../../lib/wordpress";

export async function getStaticPaths() {
  // Fetch everything every service page needs in ONE query here, instead
  // of fetching just slugs and then re-querying per-page below. That was
  // an N+1 pattern (1 query + 1 query per service) during every build —
  // this collapses it to a single round-trip to WP.
  const QUERY = `
    query AllServicesFull {
      services {
        nodes {
          slug
          title
          content
          featuredImage {
            node {
              sourceUrl
              altText
            }
          }
          servicespost {
            galleryContent
            galleryImages {
              nodes {
                sourceUrl
                altText
                mediaDetails {
                  sizes {
                    name
                    sourceUrl
                    width
                    height
                  }
                }
              }
            }
          }
        }
      }
    }
  `;

  const data = await queryWordPress(QUERY);
  const services = data?.services?.nodes || [];

  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;

if (!service) {
  return Astro.redirect("/404");
}

// Extract gallery data safely
const galleryContent = service?.servicespost?.galleryContent;
const galleryImages = service?.servicespost?.galleryImages?.nodes || [];
const heroImageSrc =
  service.featuredImage?.node?.sourceUrl ||
  "https://admin.greenmountainfencecompany.com/wp-content/uploads/2026/02/Wood-driveway-gates.webp";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={service.title}
      description={service.title}
    />

    <!-- Hero image is the LCP element on this page — preload it so the
         browser starts fetching it immediately instead of discovering it
         only once it parses down to the <img> tag. -->
    <link rel="preload" as="image" href={heroImageSrc} fetchpriority="high" />

    <!-- Loaded non-blocking: this CSS is only needed if/when someone opens
         the lightbox, so it shouldn't hold up the initial render. Falls
         back to a normal blocking link if JS is disabled. -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css"
      />
    </noscript>
  </head>
  <body>
    <Header />

    <main id="top">
      <section class="page-hero">
        <img
          src={heroImageSrc}
          alt={service.featuredImage?.node?.altText || service.title}
          class="overlays-image"
          fetchpriority="high"
          decoding="async"
        />
        <div class="container">
          <div class="breadcrumb">
            <a href="/">Home</a>
            <span>/</span>
            <a href="/service">Services</a>
            <span>/</span>
            <span style="color:#fff;">{service.title}</span>
          </div>
          <h1 class="fade-up">{service.title}</h1>
        </div>
      </section>

      <section class="contanrt-data section">
        <div class="container">
          <div
            class="all-mydata"
            set:html={service?.content || "No content available."}
          />
        </div>
      </section>

      {/* Render gallery section only if content or images exist */}
      {
        (galleryContent || galleryImages.length > 0) && (
          <section class="gallery-sec section">
            <div class="container">
              {galleryContent && (
                <div class="center-data" set:html={galleryContent} />
              )}

              <div class="gallery-grids">
                {galleryImages.map((galleryitems, index) => {
                  const sizes = galleryitems?.mediaDetails?.sizes || [];
                  
                  // Priority: 'large' -> 'medium_large' -> 'medium' -> 'thumbnail' -> Original sourceUrl
                  const largeSize = sizes.find((s) => s.name === "large")?.sourceUrl;
                  const medLargeSize = sizes.find((s) => s.name === "medium_large")?.sourceUrl;
                  const mediumSize = sizes.find((s) => s.name === "medium")?.sourceUrl;
                  const thumbSize = sizes.find((s) => s.name === "thumbnail")?.sourceUrl;

                  const displayImageSrc = largeSize || medLargeSize || mediumSize || thumbSize || galleryitems?.sourceUrl;

                  // Build responsive srcset string
                  const srcSetString = sizes
                    .map((s) => `${s.sourceUrl} ${s.width}w`)
                    .join(", ");

                  return (
                    <div class="gallery-image">
                      <a
                        href={galleryitems?.sourceUrl}
                        class="glightbox"
                        data-gallery="fence-gallery"
                      >
                        <img 
                          src={displayImageSrc} 
                          srcset={srcSetString || undefined}
                          sizes="(max-width: 767px) 50vw, (max-width: 1199px) 33vw, 25vw"
                          alt={galleryitems?.altText || service.title} 
                          loading={index === 0 ? "eager" : "lazy"}
                          decoding="async"
                          width="388"
                          height="305"
                        />
                      </a>
                    </div>
                  );
                })}
              </div>
            </div>
          </section>

        )
      }
      <Contactform/>
    </main>

    <Footer />

    <style>
      .all-mydata li {
        list-style: disc;
      }

      .center-data {
        max-width: 991px;
        width: 100%;
        margin: 0 auto;
        text-align: center;
      }

      .center-data .fs-40 {
        font-weight: 700;
      }

      .gallery-grids {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
        padding-top: 70px;
      }

      .gallery-image {
        max-width: 388px;
        width: 100%;
        height: 305px;
        margin: 0 auto;
        overflow: hidden;
        border-radius: 10px;
      }

      .gallery-image a {
        display: block;
        width: 100%;
        height: 100%;
      }

      .gallery-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
      }

      .gallery-grids .gallery-image:nth-child(1) {
        grid-column: span 2;
        grid-row: span 2;
        max-width: 100%;
        width: 100%;
        height: 626px;
      }

      section.gallery-sec {
        background: var(--off);
      }

      @media (max-width: 1600px) {
        .gallery-grids {
          padding-top: 50px;
        }
      }

      @media (max-width: 1400px) {
        .gallery-grids {
          padding-top: 30px;
        }
      }

      @media (max-width: 1199px) {
        .gallery-grids {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }

      @media (max-width: 991px) {
        .gallery-grids .gallery-image:nth-child(1) {
          grid-column: span 1;
          grid-row: span 1;
        }

        .gallery-image,
        .gallery-grids .gallery-image:nth-child(1) {
          max-width: 388px;
          width: 100%;
          height: 215px;
          margin: 0 auto;
        }
      }

      @media (max-width: 767px) {
        .gallery-sec {
          padding: 30px 0;
        }

        .gallery-grids {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }
    </style>

    <script
      is:inline
      src="https://cdn.jsdelivr.net/gh/mcstudios/glightbox/dist/js/glightbox.min.js"
      defer></script>

    <script is:inline>
      let lightboxInstance;

      function initGallery() {
        if (typeof GLightbox !== "function") return; // script not ready yet

        // Destroy any previous instance before rebinding — otherwise every
        // client-side navigation stacks another set of event listeners
        // onto the page instead of replacing the old ones.
        if (lightboxInstance) {
          lightboxInstance.destroy();
        }

        lightboxInstance = GLightbox({
          selector: ".glightbox",
          touchNavigation: true,
          loop: true,
        });
      }

      // First load: the CDN script may still be loading, so wait for the
      // browser's actual load event instead of polling every 100ms.
      if (typeof GLightbox === "function") {
        initGallery();
      } else {
        window.addEventListener("load", initGallery, { once: true });
      }

      // Client-side navigations (view transitions) — the script is already
      // loaded by now, so this re-inits immediately for the new page.
      document.addEventListener("astro:page-load", initGallery);
    </script>
  </body>
</html>