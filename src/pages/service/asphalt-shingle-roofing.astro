---


// Serve the cached page from the host's CDN for 90s, then refresh it in the
// background so WordPress edits (text/images) show up without a full site
// rebuild. See src/lib/wordpress.js for the data-fetching side.
Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=0, s-maxage=90, stale-while-revalidate=30",
);
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import Relatedservice from "../../components/Relatedservice.astro";
import { queryWordPress } from "../../lib/wordpress";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";

const PAGEJSON = `
query homepagedata {
  page(id: "/asphalt-shingle-roofing", idType: URI) {
    title
    content
    seo {
      canonical
      cornerstone
      fullHead
    }
  }
}
`;
const pagedata = await queryWordPress(PAGEJSON);
const alldata = pagedata?.page;
const seodata = alldata?.seo || {};
// console.log("alldataalldata", alldata);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      useYoast={true}
      canonical={seodata?.canonical || ""}
      focuskw={seodata?.focuskw || ""}
    />
    {seodata?.fullHead && <Fragment set:html={seodata.fullHead} />}
  </head>
  <body>
    <Header />

    <main id="top">
      <section class="page-hero">
        <div class="hero-grid-tex" aria-hidden="true"></div><div
          class="container"
        >
          <div class="breadcrumb">
            <a href="/">Home</a><span>/</span><span style="color:#fff;"
              >Asphalt Shingle Roofing</span>
          </div><h1 class="fade-up">
            Asphalt Shingle Roofing in <em
              style="font-style: normal; color: #9cc0ff;"
              >New Hampshire<br />
            </em>
          </h1>
          <p class="lede-page fade-up">
            Asphalt covers most New Hampshire homes for good reason — strong
            value, a wide colour range, and a proven service life. What
            separates a twenty-year roof from a twelve-year one is the grade you
            pick and how it goes on.
          </p>
          <div class="hero-ctas">
            <a class="btn btn-blue" href="/contact/"
              >Get a Free Estimate<br />
            </a><a class="btn btn-ghost-w" href="tel:+16035027080"
              >Call (603) 502-7080</a>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container narrow">
          <p><span class="eyebrow">The Material</span></p>
          <h2>The Workhorse of New Hampshire Roofs</h2>
          <p>
            Roughly four out of five homes in this state wear asphalt shingles.
            They are affordable, they come in every colour a neighbourhood
            association could ask for, and installed properly they will see you
            through two decades of New England weather.
          </p>
          <p>
            Where homeowners get caught out is assuming all asphalt is the same.
            There is a meaningful gap between a builder-grade three-tab shingle
            and a laminated architectural shingle rated for 150 mph winds — in
            appearance, in lifespan, and in how it behaves during a February
            nor’easter.
          </p>
          <p>
            The other half of the equation is installation. Nailing pattern,
            starter strip, ice-and-water shield placement, and attic ventilation
            determine whether a shingle reaches its rated life or falls well
            short of it. Most roofs that fail early were not defective — they
            were fitted badly.
          </p>
          <p>
            This page covers the material itself: grades, wind ratings,
            lifespan, and pricing. If you want the process of getting a roof
            replaced, that is on our <a
              style="color: var(--blue); font-weight: 500;"
              href="/service/roof-replacement/">roof replacement page</a>
          </p>
        </div>
      </section>

      <section class="section alt">
        <div class="container">
          <div class="narrow" style="text-align:center;margin-bottom:38px">
            <p><span class="eyebrow">Shingle Grades</span></p>
            <h2>Three Grades, Three Very Different Roofs</h2>
            <p class="lead">
              Every asphalt quote you receive will sit in one of these
              categories. Knowing which is how you compare two numbers fairly.
            </p>
          </div>
          <div class="sys">
            <div class="s">
              <div class="top">
                <p><span class="tag">Budget</span></p>
                <h3>3-tab shingles</h3>
                <p>Single flat layer with cut-out tabs</p>
              </div>
              <div class="body">
                <ul>
                  <li>Lowest cost per square of any shingle</li>
                  <li>Flat, uniform appearance with no shadow line</li>
                  <li>Lighter weight and lower wind resistance</li>
                  <li>Best suited to sheds, garages, and rental turnovers</li>
                </ul>
              </div>
              <div class="foot"><b>Service life in NH:</b> 15–20 years</div>
            </div>
            <div class="s">
              <div class="top">
                <p><span class="tag">Recommended</span></p>
                <h3>Architectural shingles</h3>
                <p>Multiple laminated layers, dimensional profile</p>
              </div>
              <div class="body">
                <ul>
                  <li>
                    Thicker and heavier — significantly better wind performance
                  </li>
                  <li>Shadowed, textured look that suits most NH homes</li>
                  <li>Available in wind ratings up to 150 mph</li>
                  <li>The standard choice on the large majority of our jobs</li>
                </ul>
              </div>
              <div class="foot"><b>Service life in NH:</b> 20–25 years</div>
            </div>
            <div class="s">
              <div class="top">
                <p><span class="tag">Premium</span></p>
                <h3>Designer shingles</h3>
                <p>Heavyweight laminated, slate or shake profiles</p>
              </div>
              <div class="body">
                <ul>
                  <li>
                    Mimics slate or cedar shake at a fraction of the weight
                  </li>
                  <li>Heaviest asphalt product with the longest rated life</li>
                  <li>Suits historic homes and high-value properties</li>
                  <li>Approaches metal on cost — worth comparing both</li>
                </ul>
              </div>
              <div class="foot"><b>Service life in NH:</b> 25–30 years</div>
            </div>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="narrow" style="text-align:center;margin-bottom:36px">
            <p><span class="eyebrow">Wind Performance</span></p>
            <h2>What Wind Rating Do You Actually Need?</h2>
            <p class="lead">
              Shingles are tested to ASTM standards and sold in wind classes. On
              the Seacoast this matters far more than it does inland, and it is
              the spec most quotes leave out entirely.
            </p>
          </div>
          <div class="wind">
            <div class="wr">
              <p><span class="cls">Class D</span></p>
              <div class="mph">90 mph</div>
              <p>
                Basic rating found on most three-tab products. We do not specify
                this for primary residences anywhere in New Hampshire.
              </p>
            </div>
            <div class="wr">
              <p><span class="cls">Class G</span></p>
              <div class="mph">120 mph</div>
              <p>
                Solid choice for sheltered inland homes. Standard on most
                quality architectural shingle lines.
              </p>
            </div>
            <div class="wr">
              <p><span class="cls">Class H — our Seacoast spec</span></p>
              <div class="mph">150 mph</div>
              <p>
                What we recommend for coastal and exposed hilltop sites. The
                upgrade cost is small relative to replacing wind-lifted
                sections.
              </p>
            </div>
          </div>
          <div class="card" style="margin-top:24px">
            <h3>The rating only counts if the install matches it</h3>
            <p>
              A 150 mph shingle nailed in the wrong place performs like a 90 mph
              shingle, and the manufacturer’s wind warranty will not cover it.
              High-wind ratings require a specific nail count, precise placement
              in the nailing zone, and a proper starter strip along both eaves
              and rakes. This is the single most common corner cut in roofing,
              and it is invisible once the roof is finished.
            </p>
          </div>
        </div>
      </section>

      <section class="section alt">
        <div class="container">
          <div class="narrow" style="text-align:center;margin-bottom:36px">
            <p><span class="eyebrow">Lifespan</span></p>
            <h2>What Decides How Long Your Shingles Last</h2>
            <p class="lead">
              Two identical roofs on the same street can differ by eight years.
              These are the reasons why.
            </p>
          </div>
          <div class="fac">
            <div class="f">
              <span class="n">01</span>
              <div>
                <h3>Attic ventilation</h3>
                <p>
                  The biggest single factor, and the most overlooked. Trapped
                  heat cooks shingles from underneath and can strip years off a
                  roof’s life.
                </p>
              </div>
            </div>
            <div class="f">
              <span class="n">02</span>
              <div>
                <h3>Nailing accuracy</h3>
                <p>
                  Nails placed too high, too low, overdriven, or too few. Each
                  one is a future lifted tab and a voided wind warranty.
                </p>
              </div>
            </div>
            <div class="f">
              <span class="n">03</span>
              <div>
                <h3>Sun exposure</h3>
                <p>
                  South and west-facing slopes age faster. It is normal to see
                  one side of a roof wear noticeably ahead of the other.
                </p>
              </div>
            </div>
            <div class="f">
              <span class="n">04</span>
              <div>
                <h3>Ice damming</h3>
                <p>
                  Water backing up under shingles at the eaves lifts and loosens
                  them. Ice-and-water shield is the defence, ventilation is the
                  cure.
                </p>
              </div>
            </div>
            <div class="f">
              <span class="n">05</span>
              <div>
                <h3>Overhanging trees</h3>
                <p>
                  Shade holds moisture and encourages moss and algae; falling
                  limbs bruise granules. Trimming back pays for itself.
                </p>
              </div>
            </div>
            <div class="f">
              <span class="n">06</span>
              <div>
                <h3>Coastal salt air</h3>
                <p>
                  Near the water, salt corrodes fasteners and flashing well
                  before the shingles themselves are worn out.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container narrow">
          <p><span class="eyebrow">Scope of Work</span></p>
          <h2>What’s Included in an Asphalt Shingle Install</h2>
          <p>
            The items below are standard on every asphalt roof we install. When
            a quote comes in noticeably cheaper, this list is usually where the
            gap is.
          </p>
          <ul class="checks" style="margin-top: 20px;">
            <li>Complete tear-off to the deck — we never overlay</li>
            <li>Deck inspection with rotted sheathing replaced</li>
            <li>Ice-and-water shield at eaves, valleys, and penetrations</li>
            <li>Synthetic underlayment across the full roof</li>
            <li>Manufacturer-specified nailing pattern for the wind rating</li>
            <li>New drip edge, step flashing, and pipe boots</li>
            <li>Ridge cap shingles matched to the field</li>
            <li>Ridge vent with balanced intake ventilation</li>
            <li>Daily magnetic nail sweeps and debris haul-away</li>
            <li>Permit pulled and final inspection handled</li>
            <li>Manufacturer warranty plus our 25-year workmanship warranty</li>
          </ul>
        </div>
      </section>

      <section class="section alt">
        <div class="container">
          <div class="cost-band">
            <p>
              <span class="eyebrow" style="color: #9cc0ff;"
                >Straight Pricing</span>
            </p>
            <h2>How Much Does an Asphalt Shingle Roof Cost?</h2>
            <div class="cost-figure">$8,000 – $22,000</div>
            <p>
              That is the honest range for most New Hampshire homes. A modest
              ranch with a simple gable roof in three-tab sits near the bottom;
              a large colonial in designer shingles with multiple dormers sits
              at the top. You get an itemized written estimate after an on-site
              inspection.
            </p>
            <ul class="cost-drivers">
              <li>
                <b>Roof size and pitch —</b> square footage plus how steep it is to
                work safely
              </li>
              <li>
                <b>Shingle grade —</b> three-tab, architectural, or designer
              </li>
              <li>
                <b>Wind rating —</b> Class G versus Class H on exposed sites
              </li>
              <li>
                <b>Existing layers —</b> two or three old layers means more tear-off
              </li>
              <li>
                <b>Deck condition —</b> rotted sheathing found during tear-off
              </li>
              <li>
                <b>Complexity —</b> dormers, valleys, skylights, and chimneys
              </li>
            </ul>
            <div style="margin-top: 30px;">
              <a
                class="btn btn-blue"
                style="background: #fff; color: var(--blue); box-shadow: none;"
                href="/contact/">Get Your Itemized Estimate</a
              >
            </div>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="narrow" style="text-align:center;margin-bottom:32px">
            <p><span class="eyebrow">Worth Considering</span></p>
            <h2>Should You Look at Metal Instead?</h2>
          </div>
          <div class="grid-2">
            <div class="card">
              <h3>Asphalt is usually right when…</h3>
              <p>
                You are working to a defined budget, you may sell within ten to
                fifteen years, your roof has a complex shape with many angles,
                or you want the widest possible choice of colour and profile.
                For most New Hampshire homes, architectural asphalt is the
                sensible answer.
              </p>
            </div>
            <div class="card">
              <h3>Metal is worth pricing when…</h3>
              <p>
                You intend to stay long term, the property is coastal or badly
                exposed, ice dams have been a recurring problem, or you are
                already considering designer shingles — at that price point
                metal becomes genuinely competitive over the life of the roof.
              </p>
              <p style="margin-top: 12px;">
                <a
                  style="color: var(--blue); font-weight: 500;"
                  href="/service/metal-roofing/">Compare metal roofing →</a>
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="section alt">
        <div class="container">
          <div class="narrow" style="margin-bottom:36px">
            <p><span class="eyebrow">Local Expertise</span></p>
            <h2>Specifying Asphalt for New Hampshire</h2>
            <p class="lead">
              The same shingle behaves differently in Seabrook than in Keene.
              These are the details we adjust by location.
            </p>
          </div>
          <div class="grid-2">
            <div class="card">
              <h3>Higher wind rating near the coast</h3>
              <p>
                Seacoast and exposed hilltop properties get Class H shingles
                rated to 150 mph as standard. Inland and sheltered sites are
                generally well served by Class G.
              </p>
            </div>
            <div class="card">
              <h3>Ice-and-water shield placement</h3>
              <p>
                Code sets a minimum at the eaves. On low-pitch roofs and known
                ice dam trouble spots we run it further up the slope and through
                every valley.
              </p>
            </div>
            <div class="card">
              <h3>Corrosion-resistant fasteners</h3>
              <p>
                Near the water, standard nails and flashing corrode years before
                the shingles wear out. Coastal jobs get coated or stainless
                components as standard.
              </p>
            </div>
            <div class="card">
              <h3>Ventilation sized to the attic</h3>
              <p>
                Ridge vent alone is not a ventilation system. Intake at the
                soffit has to balance the exhaust, or you get heat build-up in
                summer and ice dams in winter.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div
            class="sec-header"
            style="text-align:center; margin:0 auto 40px;"
          >
            <p><span class="eyebrow">FAQ</span></p>
            <h2 class="sec-head">Asphalt Shingle Questions</h2>
          </div>
          <div class="faq-list">
            <div class="faq-item">
              <button class="faq-q"
                ><span>How long do asphalt shingles last in New Hampshire?</span
                ><span class="plus"></span></button
              >
              <div class="faq-a">
                <p>
                  Architectural asphalt shingles typically last twenty to
                  twenty-five years in New Hampshire. Three-tab shingles reach
                  fifteen to twenty. Our freeze-thaw cycles, ice damming, and
                  coastal wind exposure all shorten shingle life compared with
                  milder climates, and attic ventilation makes a significant
                  difference — a poorly ventilated roof can lose five years or
                  more off its expected service life.
                </p>
              </div>
            </div>
            <div class="faq-item">
              <button class="faq-q"
                ><span
                  >What is the difference between 3-tab and architectural
                  shingles?</span
                ><span class="plus"></span></button
              >
              <div class="faq-a">
                <p>
                  Three-tab shingles are a single flat layer with cut-out tabs,
                  giving a uniform appearance at the lowest cost. Architectural
                  shingles are built from multiple laminated layers, which makes
                  them thicker, heavier, more wind resistant, and longer
                  lasting, with a dimensional shadowed appearance. Architectural
                  shingles cost more but are the standard choice on most New
                  Hampshire homes today.
                </p>
              </div>
            </div>
            <div class="faq-item">
              <button class="faq-q"
                ><span>What wind rating do I need in New Hampshire?</span><span
                  class="plus"></span></button
              >
              <div class="faq-a">
                <p>
                  Most inland New Hampshire homes are well served by a Class G
                  shingle rated to 120 mph. On the Seacoast and other exposed
                  sites, we recommend Class H rated to 150 mph. Rating alone is
                  not enough, however: the wind warranty only applies when the
                  shingle is installed with the manufacturer’s specified nailing
                  pattern and a proper starter strip at the eaves and rakes.
                </p>
              </div>
            </div>
            <div class="faq-item">
              <button class="faq-q"
                ><span>How much does an asphalt shingle roof cost?</span><span
                  class="plus"></span></button
              >
              <div class="faq-a">
                <p>
                  Most asphalt shingle roofs in New Hampshire cost between
                  $8,000 and $22,000. The main variables are roof size and
                  pitch, the shingle grade you choose, how many existing layers
                  need removing, and whether any decking has rotted and needs
                  replacing. Complexity matters too — dormers, valleys,
                  skylights, and chimneys all add flashing labour.
                </p>
              </div>
            </div>
            <div class="faq-item">
              <button class="faq-q"
                ><span>Do darker shingles make a house hotter?</span><span
                  class="plus"></span></button
              >
              <div class="faq-a">
                <p>
                  Slightly, though far less than most people expect. Attic
                  ventilation and insulation have a much greater effect on
                  upper-floor temperature than shingle colour does. In New
                  Hampshire the difference is modest either way, so choose the
                  colour that suits the house. If summer cooling is a real
                  concern, a reflective shingle line is worth discussing.
                </p>
              </div>
            </div>
            <div class="faq-item">
              <button class="faq-q"
                ><span>Can new shingles go over an old roof?</span><span
                  class="plus"></span></button
              >
              <div class="faq-a">
                <p>
                  Building code often permits a second layer, but we do not
                  recommend it and do not do it. Overlaying hides rotted
                  decking, traps heat that shortens shingle life, adds
                  significant weight, and voids most manufacturer warranties. It
                  saves money on tear-off and costs more over the life of the
                  roof.
                </p>
              </div>
            </div>
            <div class="faq-item">
              <button class="faq-q"
                ><span>Does shingle brand actually matter?</span><span
                  class="plus"></span></button
              >
              <div class="faq-a">
                <p>
                  Less than most homeowners assume. The major manufacturers
                  produce comparable products within each grade, and the
                  difference between a twenty-year roof and a ten-year roof is
                  almost always installation quality rather than brand. Correct
                  nailing pattern, starter strip, ice-and-water shield
                  placement, and attic ventilation matter far more than the name
                  on the bundle.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      
     
