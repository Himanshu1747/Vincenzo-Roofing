                background: linear-gradient(
                    180deg,
                    var(--blue-bright),
                    var(--blue)
                );
                color: #fff;
                box-shadow: var(--sh-blue);
            }

            .btn-blue:hover {
                transform: translateY(-2px);
            }

            .btn-ghost-w {
                border: 1.5px solid rgba(255, 255, 255, 0.35);
                color: #fff;
            }

            .btn-ghost-w:hover {
                border-color: #fff;
                background: rgba(255, 255, 255, 0.08);
            }

            /* Hero */
            .hero {
                background: linear-gradient(
                    155deg,
                    #061b3e,
                    var(--deep) 45%,
                    var(--deep-2)
                );
