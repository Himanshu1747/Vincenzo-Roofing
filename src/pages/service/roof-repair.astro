                );
            }

            .hero-grid {
                position: absolute;
                inset: 0;
                background-image:
                    linear-gradient(
                        rgba(255, 255, 255, 0.03) 1px,
                        transparent 1px
                    ),
                    linear-gradient(
                        90deg,
                        rgba(255, 255, 255, 0.03) 1px,
                        transparent 1px
                    );
                background-size: 56px 56px;
                mask-image: radial-gradient(
                    ellipse 90% 80% at 60% 20%,
                    #000,
                    transparent 78%
                );
            }

            .hero-inner {
                position: relative;
                z-index: 2;
                padding: 72px 0 76px;
                max-width: 720px;
            }

            .hero h1 {
                color: #fff;
