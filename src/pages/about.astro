---
export const prerender = false;

// Serve the cached page from the host's CDN for 90s, then refresh it in the
// background so WordPress edits (text/images) show up without a full site
// rebuild. See src/lib/wordpress.js for the data-fetching side.
Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=0, s-maxage=90, stale-while-revalidate=30",
);
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { queryWordPress } from "../lib/wordpress";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

const PAGEJSON = `
query homepagedata {
  page(id: "/about", idType: URI) {
    title
    content
    seo {
      canonical
      cornerstone
      fullHead
    }
  }
}
`;
const pagedata = await queryWordPress(PAGEJSON);
const alldata = pagedata?.page;
const seodata = alldata?.seo || {};
const aboutData = alldata?.about;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      useYoast={true}
      canonical={seodata?.canonical || ""}
      focuskw={seodata?.focuskw || ""}
    />
    {seodata?.fullHead && <Fragment set:html={seodata.fullHead} />}
  </head>
  <body>
    <Header />

    <main id="top">
      <!-- Page hero -->
      <section class="page-hero">
        <div class="hero-grid-tex" aria-hidden="true"></div>
        <div class="container">
          <div class="breadcrumb">
            <a href="/">Home</a><span>/</span><span style="color:#fff;"
              >About</span
            >
          </div>
          <h1 class="fade-up">
            A Seabrook Roofing Crew, Serving All of <em
              style="font-style: normal; color: #9cc0ff;">New Hampshire</em
            >
          </h1>
          <p class="lede-page fade-up">
            Vincenzo's Roofing is based on the New Hampshire Seacoast and works
            across the entire state. Over a decade of hands on roofing, in house
            crews on every job, and a 25 year workmanship warranty in writing.
          </p>
          <div class="hero-ctas">
            <a class="btn btn-blue" href="/contact/">Get a Free Estimate</a><br
            /><a class="btn btn-ghost-w" href="tel:+16035027080"
              >Call (603) 502-7080</a
            >
          </div>
        </div>
      </section>

      <!-- Story -->
      <section class="section">
        <div class="container story-wrap">
          <div class="story-media">
            <div class="photo-frame ratio-4-3">
              <img
                src="/about-image.webp"
                alt="Vincenzo's Roofing team reviewing a project plan on-site"
                loading="lazy"
              />
            </div>
          </div>
          <div class="story-copy">
            <p><span class="eyebrow">Our Story</span></p>
            <h2 class="sec-head">
              Over a Decade on<br />
              <span class="accent">New England Roofs</span>
            </h2>
            <p>
              Vincenzo's Roofing was built by Vincenzo, who has spent more than
              ten years working on New Hampshire roofs.
            </p>

            <p>
              That experience was earned in the conditions this region actually
              produces: Seacoast homes taking salt air and wind straight off the
              water, inland colonials with ice damming every February, and flat
              commercial roofs where one blocked drain becomes somebody's ruined
              stock room.
            </p>

            <p>
              He built this company around the things he saw done badly
              elsewhere. Written estimates instead of lump sums. Our own crews
              instead of subcontracted labor. Warranties in writing, registered
              before we leave. Accountability sitting with one company rather
              than being passed down a chain until nobody owns the problem.
            </p>

            <p>
              We are based in Seabrook, which puts us within a short drive of
              the whole Seacoast and on the road across the rest of New
              Hampshire daily. More than 100 completed projects later, Vincenzo
              still answers the emergency line himself.
            </p>
          </div>
        </div>
      </section>

      <!-- Stats -->
      <section class="section" style="padding-top:0;">
        <div class="container">
          <div class="stat-strip">
            <div class="stat-box reveal">
              <p><b>10+</b>Years of Experience</p>
            </div>
            <div class="stat-box reveal">
              <p><b>100+</b>Projects Completed</p>
            </div>
            <div class="stat-box reveal">
              <p><b>4.9★</b>Average Rating</p>
            </div>
            <div class="stat-box reveal">
              <p><b>25 yr</b>Workmanship Warranty</p>
            </div>
          </div>
        </div>
      </section>
<section class="materials-section">
  <div class="container">
    <div class="materials-card">
      
      <!-- Section Header -->
      <div class="materials-header">
        <span class="eyebrow">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor">
            <polygon points="12 2 22 22 2 22"></polygon>
          </svg>
          MATERIALS WE WORK WITH
        </span>
        <h2>Products We Install</h2>
        <p class="lead">
          We specify from established manufacturers with real warranty programs behind them, and we match the product to the property rather than to whatever we have a deal on this month.
        </p>
      </div>

      <!-- Divider -->
      <hr class="materials-divider" />

      <!-- Brands Grid Columns -->
      <div class="brands-grid">
        
        <!-- Column 1: Roofing -->
        <div class="brand-col">
          <h4 class="brand-category">ROOFING</h4>
          <ul class="brand-list">
            <li>
              <span class="bullet"></span>
              <div class="brand-info">
                <strong>GAF</strong>
              </div>
            </li>
            <li>
              <span class="bullet"></span>
              <div class="brand-info">
                <strong>CertainTeed</strong>
              </div>
            </li>
          
            <li>
              <span class="bullet"></span>
              <div class="brand-info">
                <strong>IKO</strong>
              </div>
            </li>
            <li>
              <span class="bullet"></span>
              <div class="brand-info">
                <strong>Tamko</strong>
              </div>
            </li>
            <li>
              <span class="bullet"></span>
              <div class="brand-info">
                <strong>Drexel</strong>
                <span class="brand-desc">Standing seam metal</span>
              </div>
            </li>
          </ul>
        </div>

        <!-- Column 2: Siding -->
        <div class="brand-col">
          <h4 class="brand-category">SIDING</h4>
          <ul class="brand-list">
            <li>
              <span class="bullet"></span>
              <div class="brand-info">
                <strong>James Hardie</strong>
                <span class="brand-desc">Fiber cement</span>
              </div>
            </li>
           
            <li>
              <span class="bullet"></span>
              <div class="brand-info">
                <strong>SBC Cedar</strong>
                <span class="brand-desc">Cedar shake siding</span>
              </div>
            </li>
          </ul>
        </div>

        <!-- Column 3: Trim & Exteriors -->
        <div class="brand-col">
          <h4 class="brand-category">TRIM AND EXTERIORS</h4>
          <ul class="brand-list">
            <li>
              <span class="bullet"></span>
              <div class="brand-info">
                <strong>Wolf</strong>
                <span class="brand-desc">PVC trim and decking</span>
              </div>
            </li>
          </ul>
        </div>

      </div>

    </div>
  </div>
</section>  
      <!-- Values -->
      <section class="section">
        <div class="container">
          <div class="sec-header">
            <p><span class="eyebrow">What We Stand For</span></p>
            <h2 class="sec-head">
              Four things we<br />
              <span class="accent">won’t compromise on.</span>
            </h2>
          </div>
          <div class="values-grid">
            <!-- Itemized written estimates -->
            <div class="value-card reveal">
              <div class="why-icon">
                <svg
                  width="21"
                  height="21"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-label="Itemized written estimates icon"
                >
                  <path
                    d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
                  ></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                  <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
              </div>
              <h4>Itemized written estimates</h4>
              <p>
                Materials, labor, permit, and timeline broken out line by line.
                A lump sum tells you nothing about what you are buying, and it
                makes comparing quotes impossible.
              </p>
            </div>

            <!-- Our own crews, never subcontracted -->
            <div class="value-card reveal">
              <div class="why-icon">
                <svg
                  width="21"
                  height="21"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-label="In-house crew icon"
                >
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
              </div>
              <h4>Our own crews, never subcontracted</h4>
              <p>
                The crew that quotes your roof is the crew that installs it. No
                handoff to a team you have never met after you sign.
              </p>
            </div>

            <!-- A 25 year workmanship warranty -->
            <div class="value-card reveal">
              <div class="why-icon">
                <svg
                  width="21"
                  height="21"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-label="Warranty icon"
                >
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  <path d="m9 12 2 2 4-4"></path>
                </svg>
              </div>
              <h4>A 25 year workmanship warranty</h4>
              <p>
                Separate from the manufacturer's material coverage, written out
                and registered before we pull off your driveway.
              </p>
            </div>

            <!-- Daily cleanup, not final day cleanup -->
            <div class="value-card reveal">
              <div class="why-icon">
                <svg
                  width="21"
                  height="21"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-label="Clean up icon"
                >
                  <path d="M12 2v20"></path>
                  <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"
                  ></path>
                </svg>
              </div>
              <h4>Daily cleanup, not final day cleanup</h4>
              <p>
                Magnetic nail sweeps and full debris removal at the end of every
                working day. Your driveway is usable the whole way through.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Team -->

      <!-- Timeline -->
      <section class="section" style="background:var(--off);">
        <div class="container">
          <div class="sec-header">
            <p><span class="eyebrow">Where We Stand Today</span></p>
            <h2 class="sec-head">
              Thirteen years,<br />
              <span class="accent">one town at a time.</span>
            </h2>
          </div>
          <div class="timeline">
            <div class="timeline-item reveal">
              <p><b>10+ years on New England roofs</b></p>
              <h4>Local Experience</h4>
              <p>
                The crew learned this trade on Seacoast homes taking salt air
                off the water, inland colonials with ice damming, and flat
                commercial roofs.
              </p>
            </div>

            <div class="timeline-item reveal">
              <p><b>100+ projects completed</b></p>
              <h4>Proven Track Record</h4>
              <p>
                Residential and commercial work across New Hampshire, from
                single repairs to full commercial re roofs.
              </p>
            </div>

            <div class="timeline-item reveal">
              <p><b>4.9 average rating</b></p>
              <h4>Customer Trusted</h4>
              <p>
                From verified customers on Google. Read them at the source
                rather than taking our word for it.
              </p>
            </div>

            <div class="timeline-item reveal">
              <p><b>25 year workmanship warranty</b></p>
              <h4>Guaranteed Quality</h4>
              <p>
                Written out and registered before we pull off your driveway,
                separate from the manufacturer's material coverage.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA band -->
      <section class="cta-band">
        <div class="cta-inner">
          <h2>Want to talk to the crew <em>before you book?</em></h2>
          <div class="btns">
            <a class="btn btn-blue" href="/free-estimate"
              >Get Your Free Estimate<br /></a
            >
            <a class="btn btn-ghost-w" href="tel:+1 (603) 502-7080">Call Now</a>
          </div>
        </div>
      </section>
    </main>
    <Footer />
    <style is:global>
      /* ============ Products We Install (Materials) ============ */
      .materials-box {
        background: linear-gradient(
          135deg,
          var(--deep) 0%,
          #06193b 50%,
          var(--deep-2) 100%
        );
        position: relative;
        border-radius: 26px; /* Matches your hero-card radius */
        padding: 56px 64px;
        color: var(--white);
        overflow: hidden;
        box-shadow: var(--sh-lg);
      }

      /* Recreates the blue radial glow in the top right of the image */
      .materials-glow {
        position: absolute;
        top: -30%;
        right: -10%;
        width: 60%;
        height: 100%;
        background: radial-gradient(
          circle,
          rgba(26, 95, 208, 0.35),
          transparent 70%
        );
        z-index: 0;
        pointer-events: none;
      }

      .materials-box > * {
        position: relative;
        z-index: 1;
      }

      .materials-eyebrow {
        color: #9cc0ff;
      }

      .materials-eyebrow::before {
        background: #9cc0ff;
      }

      .materials-box h2 {
        color: var(--white);
        font-size: clamp(30px, 4vw, 42px);
        margin: 12px 0 20px;
        letter-spacing: -0.02em;
      }
.materials-section {
  padding: 40px 0;
}

/* Rounded Dark Card Container */
.materials-card {
  background-color: var(--deep);
  background-image: radial-gradient(circle at top right, var(--deep-2) 0%, var(--deep) 70%);
  border-radius: var(--r-lg);
  padding: 56px 48px;
  color: var(--white);
  box-shadow: var(--sh-lg);
}

/* Header Text */
.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--blue-soft);
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  margin-bottom: 12px;
}

.materials-header h2 {
  color: var(--white);
  font-size: 2.25rem;
  font-weight: 700;
  margin: 0 0 16px 0;
  line-height: 1.2;
}

.materials-header .lead {
  color: rgba(255, 255, 255, 0.8);
  font-size: 1.05rem;
  line-height: 1.6;
  max-width: 680px;
  margin: 0;
}

/* Horizontal Line Divider */
.materials-divider {
  border: none;
  height: 1px;
  background-color: var(--line-dark);
  margin: 40px 0;
}

/* Grid Layout */
.brands-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 40px;
}

/* Category Titles */
.brand-category {
  color: var(--blue-soft);
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 1.2px;
  text-transform: uppercase;
  margin: 0 0 24px 0;
}

/* Brand Items */
.brand-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.brand-list li {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  margin-bottom: 20px;
}

.bullet {
  width: 6px;
  height: 6px;
  background-color: var(--blue-soft);
  border-radius: 50%;
  margin-top: 7px;
  flex-shrink: 0;
}

/* Brand Text Detail */
.brand-info {
  display: flex;
  flex-direction: column;
}

.brand-info strong {
  color: var(--white);
  font-size: 1.02rem;
  font-weight: 600;
  line-height: 1.3;
}

.brand-desc {
  color: var(--blue-soft);
  font-size: 0.85rem;
  font-weight: 400;
  margin-top: 3px;
}

/* Mobile Responsiveness */
@media (max-width: 868px) {
  .materials-card {
    padding: 36px 24px;
  }

  .brands-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }
}

@media (max-width: 576px) {
  .brands-grid {
    grid-template-columns: 1fr;
    gap: 28px;
  }
}
      .materials-box p {
        color: #c6d4ec;
        font-size: 16px;
        max-width: 680px;
        line-height: 1.65;
        margin-bottom: 48px;
      }

      .materials-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 40px;
        border-top: 1px solid rgba(255, 255, 255, 0.12);
        padding-top: 48px;
      }

      .col-title {
        font-family: "Montserrat", sans-serif;
        font-size: 12px;
        font-weight: 700;
        color: #9cc0ff;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        margin-bottom: 24px;
      }

      .material-list {
        display: flex;
        flex-direction: column;
        gap: 20px;
      }

      .material-list li {
        position: relative;
        padding-left: 20px;
      }

      /* Custom blue bullet points */
      .material-list li::before {
        content: "";
        position: absolute;
        left: 0;
        top: 9px;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--blue-soft);
      }

      .m-name {
        display: block;
        color: var(--white);
        font-weight: 600;
        font-size: 15.5px;
      }

      .m-desc {
        display: block;
        color: #8fa3c4;
        font-size: 13.5px;
        margin-top: 4px;
      }

      /* Responsive adjustments */
      @media (max-width: 900px) {
        .materials-grid {
          grid-template-columns: repeat(2, 1fr);
          gap: 48px 30px;
        }
      }

      @media (max-width: 600px) {
        .materials-box {
          padding: 40px 24px;
          border-radius: 20px;
        }

        .materials-grid {
          grid-template-columns: 1fr;
          padding-top: 36px;
        }

        .materials-box p {
          margin-bottom: 36px;
        }
      }
    </style>
  </body>
</html>
