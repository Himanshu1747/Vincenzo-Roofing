---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { queryWordPress } from "../lib/wordpress";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

const PAGEJSON = `
query homepagedata {
  page(id: "/about", idType: URI) {
    title
    content
    about {
      ourStoryImage {
        node {
          mediaItemUrl
        }
      }
      ourStoryContent
      ourStoryGrid {
        gridContent
      }
      whatWeStandForContent
      whatWeStandGrid {
        weStandIcon {
          node {
            mediaItemUrl
          }
        }
        whatWeStandGridContent
      }
      meetTheCrewContent
      crewGrids{
        crewImage{
          node{
            mediaItemUrl
          }
        }
        crewInfo
      }
      milestonesContent
      milestonesGrid{
        milestonesGridContent
      }
      finalCtaContent
    }
  }
}
`;
const pagedata = await queryWordPress(PAGEJSON);
const alldata = pagedata?.page;
const aboutData = alldata?.about;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />

  </head>
  <body>
    <Header />

    <main id="top">
      <!-- Page hero -->
      <section class="page-hero">
        <div class="hero-grid-tex" aria-hidden="true"></div>
        <div class="container">
          <div class="breadcrumb">
            <a href="/">Home</a>
            <span>/</span>
            <span style="color:#fff;">About</span>
          </div>
          {alldata?.content && <Fragment set:html={alldata.content} />}
        </div>
      </section>

      <!-- Story -->
      <section class="section">
        <div class="container story-wrap">
          <div class="story-media">
            <div class="photo-frame ratio-4-3">
              <img
                src={aboutData?.ourStoryImage?.node?.mediaItemUrl}
                onerror="imgFallback(this,'about-team')"
                alt="Vincenzo's Roofing team reviewing a project plan on-site"
                loading="lazy"
              />
            </div>
            <!-- <div class="badge-founded">
              <b>2013</b><span>Founded in NH</span>
            </div> -->
          </div>
          <div class="story-copy">
            {aboutData?.ourStoryContent && <Fragment set:html={aboutData.ourStoryContent} />}
          </div>
        </div>
      </section>

      <!-- Stats -->
      <section class="section" style="padding-top:0;">
        <div class="container">
          <div class="stat-strip">
            {aboutData?.ourStoryGrid?.map((item) => (
              <div class="stat-box reveal">
                {item?.gridContent && <Fragment set:html={item.gridContent} />}
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Values -->
      <section class="section">
        <div class="container">
          <div class="sec-header">
            {aboutData?.whatWeStandForContent && <Fragment set:html={aboutData.whatWeStandForContent} />}
          </div>
          <div class="values-grid">
            {aboutData?.whatWeStandGrid?.map((item) => (
              <div class="value-card reveal">
                <div class="why-icon">
                   <img 
                     src={item?.weStandIcon?.node?.mediaItemUrl || ""} 
                     alt="image" 
                     height="21" 
                     width="21" 
                   />
                </div>
                {item?.whatWeStandGridContent && <Fragment set:html={item.whatWeStandGridContent} />}
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Team -->
      <section class="section">
        <div class="container">
          <div class="sec-header">
            {aboutData?.meetTheCrewContent && <Fragment set:html={aboutData.meetTheCrewContent} />}
          </div>
          <div class="team-grid">
            {aboutData?.crewGrids?.map((crew) => (
              <div class="team-card reveal">
                <div class="photo-frame ratio-1-1">
                  <img
                    src={crew?.crewImage?.node?.mediaItemUrl}
                    onerror="imgFallback(this,'team')"
                    alt="Team member"
                    loading="lazy"
                  />
                </div>
                {crew?.crewInfo && <Fragment set:html={crew.crewInfo} />}
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Timeline -->
      <section class="section" style="background:var(--off);">
        <div class="container">
          <div class="sec-header">
            {aboutData?.milestonesContent && <Fragment set:html={aboutData.milestonesContent} />}
          </div>
          <div class="timeline">
            {aboutData?.milestonesGrid?.map((milestone) => (
              <div class="timeline-item reveal">
                {milestone?.milestonesGridContent && <Fragment set:html={milestone.milestonesGridContent} />}
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- CTA band -->
      <section class="cta-band">
        <div class="cta-inner">
          {aboutData?.finalCtaContent && <Fragment set:html={aboutData.finalCtaContent} />}
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>