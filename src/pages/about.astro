---


// Serve the cached page from the host's CDN for 90s, then refresh it in the
// background so WordPress edits (text/images) show up without a full site
// rebuild. See src/lib/wordpress.js for the data-fetching side.
Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=0, s-maxage=90, stale-while-revalidate=30",
);

import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { queryWordPress } from "../lib/wordpress";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

const PAGEJSON = `
query aboutpagedata {
  page(id: "/about", idType: URI) {
    title
    content
    seo {
      canonical
      cornerstone
      fullHead
    }
    aboutPage {
      ourStoryContent
      ourStoryImage {
        node {
          mediaItemUrl
        }
      }
      ourStoryGrids {
        ourStoryGridContent
      }
      materialsWeWorkWithContent
      brandDatagrids {
        brandDatagridsContentHere
      }
      whatWeStandForContent
      whatWeStanfGrid {
        whatWeStanfGridIconImage {
          node {
            mediaItemUrl
          }
        }
        whatWeStanfGridContent
      }
      whereWeStandTodayContent
      timlineGrids {
        timlineContentGrids
      }
      finalCtaContent
    }
  }
}
`;

const pagedata = await queryWordPress(PAGEJSON);
const alldata = pagedata?.page || {};
const seodata = alldata?.seo || {};
const aboutData = alldata?.aboutPage || {};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      useYoast={true}
      canonical={seodata?.canonical || ""}
      focuskw={seodata?.focuskw || ""}
    />
    {seodata?.fullHead && <Fragment set:html={seodata.fullHead} />}
  </head>
  <body>
    <Header />

    <main id="top">
      <!-- Page hero -->
      <section class="page-hero">
        <div class="hero-grid-tex" aria-hidden="true"></div>
        <div class="container">
          <div class="breadcrumb">
            <a href="/">Home</a><span>/</span><span style="color:#fff;"
              >About</span
            >
          </div>
          {alldata?.content && <Fragment set:html={alldata.content} />}
        </div>
      </section>

      <!-- Story -->
      <section class="section">
        <div class="container story-wrap">
          <div class="story-media">
            <div class="photo-frame ratio-4-3">
              <img
                src={aboutData?.ourStoryImage?.node?.mediaItemUrl ||
                  "/about-image.webp"}
                alt="Vincenzo's Roofing team reviewing a project plan on-site"
                loading="lazy"
              />
            </div>
          </div>
          <div class="story-copy">
            {
              aboutData?.ourStoryContent && (
                <Fragment set:html={aboutData.ourStoryContent} />
              )
            }
          </div>
        </div>
      </section>

      <!-- Stats -->
      {
        aboutData?.ourStoryGrids && aboutData.ourStoryGrids.length > 0 && (
          <section class="section" style="padding-top:0;">
            <div class="container">
              <div class="stat-strip">
                {aboutData.ourStoryGrids.map((grid: any) => (
                  <div class="stat-box reveal">
                    {grid?.ourStoryGridContent && (
                      <Fragment set:html={grid.ourStoryGridContent} />
                    )}
                  </div>
                ))}
              </div>
            </div>
          </section>
        )
      }

      <!-- Materials Section -->
      <section class="materials-section">
        <div class="container">
          <div class="materials-card">
            <!-- Section Header -->
            <div class="materials-header">
              {
                aboutData?.materialsWeWorkWithContent && (
                  <Fragment set:html={aboutData.materialsWeWorkWithContent} />
                )
              }
            </div>

            <!-- Divider -->
            <hr class="materials-divider" />

            <!-- Brands Grid Columns -->
            <div class="brands-grid">
              {
                aboutData?.brandDatagrids?.map((brand: any) => (
                  <Fragment set:html={brand?.brandDatagridsContentHere} />
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <!-- Values -->
      <section class="section">
        <div class="container">
          <div class="sec-header">
            {
              aboutData?.whatWeStandForContent && (
                <Fragment set:html={aboutData.whatWeStandForContent} />
              )
            }
          </div>
          <div class="values-grid">
            {
              aboutData?.whatWeStanfGrid?.map((item: any) => {
                const iconUrl =
                  item?.whatWeStanfGridIconImage?.node?.mediaItemUrl;
                return (
                  <div class="value-card reveal">
                    {iconUrl && (
                      <div class="why-icon">
                        <img
                          src={iconUrl}
                          alt="Value Icon"
                          width="21"
                          height="21"
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                    )}
                    {item?.whatWeStanfGridContent && (
                      <Fragment set:html={item.whatWeStanfGridContent} />
                    )}
                  </div>
                );
              })
            }
          </div>
        </div>
      </section>

      <!-- Timeline -->
      <section class="section" style="background:var(--off);">
        <div class="container">
          <div class="sec-header">
            {
              aboutData?.whereWeStandTodayContent && (
                <Fragment set:html={aboutData.whereWeStandTodayContent} />
              )
            }
          </div>
          <div class="timeline">
            {
              aboutData?.timlineGrids?.map((item: any) => (
                <div class="timeline-item reveal">
                  {item?.timlineContentGrids && (
                    <Fragment set:html={item.timlineContentGrids} />
                  )}
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- CTA band -->
      <section class="cta-band">
        <div class="cta-inner">
          {
            aboutData?.finalCtaContent && (
              <Fragment set:html={aboutData.finalCtaContent} />
            )
          }
        </div>
      </section>
    </main>

    <Footer />

    <style is:global>
      /* ============ Products We Install (Materials) ============ */
      .materials-box {
        background: linear-gradient(
          135deg,
          var(--deep) 0%,
          #06193b 50%,
          var(--deep-2) 100%
        );
        position: relative;
        border-radius: 26px;
        padding: 56px 64px;
        color: var(--white);
        overflow: hidden;
        box-shadow: var(--sh-lg);
      }
      .brand-info br {
        display: none;
      }
      .materials-glow {
        position: absolute;
        top: -30%;
        right: -10%;
        width: 60%;
        height: 100%;
        background: radial-gradient(
          circle,
          rgba(26, 95, 208, 0.35),
          transparent 70%
        );
        z-index: 0;
        pointer-events: none;
      }

      .materials-box > * {
        position: relative;
        z-index: 1;
      }

      .materials-eyebrow {
        color: #9cc0ff;
      }

      .materials-eyebrow::before {
        background: #9cc0ff;
      }

      .materials-box h2 {
        color: var(--white);
        font-size: clamp(30px, 4vw, 42px);
        margin: 12px 0 20px;
        letter-spacing: -0.02em;
      }

      .materials-section {
        padding: 40px 0;
      }

      /* Rounded Dark Card Container */
      .materials-card {
        background-color: var(--deep);
        background-image: radial-gradient(
          circle at top right,
          var(--deep-2) 0%,
          var(--deep) 70%
        );
        border-radius: var(--r-lg);
        padding: 56px 48px;
        color: var(--white);
        box-shadow: var(--sh-lg);
      }

      /* Header Text */
      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--blue-soft);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 12px;
      }

      .materials-header h2 {
        color: var(--white);
        font-size: 2.25rem;
        font-weight: 700;
        margin: 0 0 16px 0;
        line-height: 1.2;
      }

      .materials-header .lead {
        color: rgba(255, 255, 255, 0.8);
        font-size: 1.05rem;
        line-height: 1.6;
        max-width: 680px;
        margin: 0;
      }

      /* Horizontal Line Divider */
      .materials-divider {
        border: none;
        height: 1px;
        background-color: var(--line-dark);
        margin: 40px 0;
      }

      /* Grid Layout */
      .brands-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 40px;
      }

      /* Category Titles */
      .brand-category {
        color: var(--blue-soft);
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        margin: 0 0 24px 0;
      }

      /* Brand Items */
      .brand-list {
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .brand-list li {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 20px;
      }

      .bullet {
        width: 6px;
        height: 6px;
        background-color: var(--blue-soft);
        border-radius: 50%;
        margin-top: 7px;
        flex-shrink: 0;
      }

      /* Brand Text Detail */
      .brand-info {
        display: flex;
        flex-direction: column;
      }

      .brand-info strong {
        color: var(--white);
        font-size: 1.02rem;
        font-weight: 600;
        line-height: 1.3;
      }

      .brand-desc {
        color: var(--blue-soft);
        font-size: 0.85rem;
        font-weight: 400;
        margin-top: 3px;
      }

      /* Mobile Responsiveness */
      @media (max-width: 868px) {
        .materials-card {
          padding: 36px 24px;
        }

        .brands-grid {
          grid-template-columns: repeat(2, 1fr);
          gap: 32px;
        }
      }

      @media (max-width: 576px) {
        .brands-grid {
          grid-template-columns: 1fr;
          gap: 28px;
        }
      }

      .materials-box p {
        color: #c6d4ec;
        font-size: 16px;
        max-width: 680px;
        line-height: 1.65;
        margin-bottom: 48px;
      }

      .materials-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 40px;
        border-top: 1px solid rgba(255, 255, 255, 0.12);
        padding-top: 48px;
      }

      .col-title {
        font-family: "Montserrat", sans-serif;
        font-size: 12px;
        font-weight: 700;
        color: #9cc0ff;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        margin-bottom: 24px;
      }

      .material-list {
        display: flex;
        flex-direction: column;
        gap: 20px;
      }

      .material-list li {
        position: relative;
        padding-left: 20px;
      }

      .material-list li::before {
        content: "";
        position: absolute;
        left: 0;
        top: 9px;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--blue-soft);
      }

      .m-name {
        display: block;
        color: var(--white);
        font-weight: 600;
        font-size: 15.5px;
      }

      .m-desc {
        display: block;
        color: #8fa3c4;
        font-size: 13.5px;
        margin-top: 4px;
      }

      @media (max-width: 900px) {
        .materials-grid {
          grid-template-columns: repeat(2, 1fr);
          gap: 48px 30px;
        }
      }

      @media (max-width: 600px) {
        .materials-box {
          padding: 40px 24px;
          border-radius: 20px;
        }

        .materials-grid {
          grid-template-columns: 1fr;
          padding-top: 36px;
        }

        .materials-box p {
          margin-bottom: 36px;
        }
      }
    </style>
  </body>
</html>
