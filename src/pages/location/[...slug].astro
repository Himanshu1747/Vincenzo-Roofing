                object-position: center;
            }

            .gallery-grids .gallery-image:nth-child(1) {
                grid-column: span 2;
                grid-row: span 2;
                max-width: 100%;
                width: 100%;
                height: 626px;
            }

            section.gallery-sec {
                background: var(--off);
            }

            @media (max-width: 1600px) {
                .gallery-grids {
                    padding-top: 50px;
                }
            }

            @media (max-width: 1400px) {
                .gallery-grids {
                    padding-top: 30px;
                }
            }

            @media (max-width: 1199px) {
