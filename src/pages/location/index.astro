---


// Serve the cached page from the host's CDN for 90s, then refresh it in the
// background so WordPress edits (text/images) show up without a full site
// rebuild. See src/lib/wordpress.js for the data-fetching side.
Astro.response.headers.set(
	"Cache-Control",
	"public, max-age=0, s-maxage=90, stale-while-revalidate=30"
);
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import { queryWordPress } from "../../lib/wordpress";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";

const LOCATIONPAGE = `
query locationpage {
  page(id: "/location", idType: URI) {
    title
    content
    seo {
      canonical
      cornerstone
      fullHead
    }
  }
}
`;

// NOTE: added a "first" limit — this query previously fetched every single
// location post with full content + all image sizes, unbounded. That's
// likely a bigger perf cost than anything else on this page. Raise the
// number (or add real pagination) if you need more than 24 on this page.
const LOCATIONALL = `
query locationall {
  locationpost (first: 24) {
    nodes {
      slug
      title
      excerpt
      content
      featuredImage {
        node {
          sourceUrl
          altText
          mediaDetails {
            sizes {
              name
              sourceUrl
              width
              height
            }
          }
        }
      }
    }
  }
}
`;

// These two queries don't depend on each other, so fire them in parallel
// instead of awaiting one after the other — this alone roughly halves the
// network wait time for this page.
const [pagedata, postdata] = await Promise.all([
  queryWordPress(LOCATIONPAGE),
  queryWordPress(LOCATIONALL),
]);

const responsedata = pagedata?.page || {};
const seodata = responsedata?.seo || {};
const postrespons = postdata?.locationpost?.nodes || [];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      useYoast={true}
      canonical={seodata?.canonical || ""}
      focuskw={seodata?.focuskw || ""}
    />
    {seodata?.fullHead && <Fragment set:html={seodata.fullHead} />}
  </head>
  <body>
    <Header />

    <main id="top">
      <section class="page-hero">
        <div class="container">
          <div class="breadcrumb">
            <a href="/">Home</a>
            <span>/</span>
            <span style="color:#fff;">Location</span>
          </div>
          <Fragment set:html={responsedata?.content || "error"} />
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="gallery-masonry">
            {
              postrespons?.map((postitems) => (
                <a
                  href={`/location/${postitems.slug}`}
                  class="photo-frame"
                  data-cat="residential"
                >
                  <img
                    src={
                      postitems?.featuredImage?.node?.sourceUrl ||
                      "/placeholder.jpg"
                    }
                    alt={postitems?.title}
                    width="434"
                    height="289"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="g-cap">{postitems?.title}</div>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <section class="cta-band">
        <div class="cta-inner">
          <Fragment
            set:html={responsedata?.locationPage?.ctaLocation || "errror"}
          />
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>