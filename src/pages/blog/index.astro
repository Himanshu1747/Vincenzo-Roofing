---


Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=0, s-maxage=90, stale-while-revalidate=30"
);

import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import { queryWordPress } from "../../lib/wordpress";

const PAGEDATA = `
query blogpage {
  page(id: "/blog", idType: URI) {
    title
    content
    seo {
      canonical
      cornerstone
      fullHead
    }
  }
}
`;

const MAINBLOG = `
query MainBlog {
  posts(first: 100) {
    nodes {
      id
      title
      slug
      excerpt
      date
      featuredImage {
        node {
          sourceUrl
          altText
          mediaDetails {
            width
            height
            sizes {
              name
              sourceUrl
              width
              height
            }
          }
        }
      }
    }
  }
}
`;

// Execute Queries
const [pageResponse, rawData] = await Promise.all([
  queryWordPress(PAGEDATA),
  queryWordPress(MAINBLOG),
]);

const pageData = pageResponse?.page;
const seodata = pageData?.seo || {};

// Safely resolve nested response structure (handles raw WP-GraphQL response vs parsed body)
const posts = rawData?.posts?.nodes || rawData?.data?.posts?.nodes || [];

const featuredPost = posts[0];
const gridPosts = posts.slice(1);

function formatDate(dateString: string) {
  if (!dateString) return "";
  return new Date(dateString).toLocaleDateString("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
  });
}

function cleanExcerpt(excerpt: string) {
  if (!excerpt) return "";
  return excerpt.replace(/<[^>]*>?/gm, "").trim();
}

function getImageUrl(imgNode: any, fallback: string) {
  if (!imgNode) return fallback;
  const sizes = imgNode.mediaDetails?.sizes || [];
  const large = sizes.find((s: any) => s.name === "large");
  return large?.sourceUrl || imgNode.sourceUrl || fallback;
}

function getImageSrcSet(imgNode: any) {
  const sizes = imgNode?.mediaDetails?.sizes || [];
  if (!sizes.length) return undefined;
  return sizes
    .filter((s: any) => s.sourceUrl && s.width)
    .map((s: any) => `${s.sourceUrl} ${s.width}w`)
    .join(", ");
}

// Convert String dimensions from GraphQL into Numbers safely
function getImageDimensions(imgNode: any, fallback: { width: number; height: number }) {
  if (!imgNode) return fallback;
  const sizes = imgNode.mediaDetails?.sizes || [];
  const large = sizes.find((s: any) => s.name === "large");
  
  const w = parseInt(large?.width || imgNode.mediaDetails?.width, 10);
  const h = parseInt(large?.height || imgNode.mediaDetails?.height, 10);

  if (!isNaN(w) && !isNaN(h) && w > 0 && h > 0) {
    return { width: w, height: h };
  }
  return fallback;
}

const FEATURED_FALLBACK = { width: 1024, height: 768 };
const GRID_FALLBACK = { width: 800, height: 600 };
const FALLBACK_IMG = "https://staging.vincenzoroofing.com/wp-content/uploads/2026/08/metal-roofing-nh-1.png";

const INITIAL_COUNT = 9;
const visibleGridPosts = gridPosts.slice(0, INITIAL_COUNT);
const deferredGridPosts = gridPosts.slice(INITIAL_COUNT);

const deferredPayload = deferredGridPosts.map((post) => {
  const node = post.featuredImage?.node;
  const dims = getImageDimensions(node, GRID_FALLBACK);
  return {
    slug: post.slug,
    title: post.title,
    excerpt: cleanExcerpt(post.excerpt),
    date: formatDate(post.date),
    imgSrc: getImageUrl(node, FALLBACK_IMG),
    imgSrcSet: getImageSrcSet(node) || "",
    imgWidth: dims.width,
    imgHeight: dims.height,
    imgAlt: node?.altText || post.title,
  };
});

const deferredJson = JSON.stringify(deferredPayload).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      useYoast={true}
      canonical={seodata?.canonical || ""}
      focuskw={seodata?.focuskw || ""}
    />
    {seodata?.fullHead && <Fragment set:html={seodata.fullHead} />}
    <link rel="preconnect" href="https://staging.vincenzoroofing.com" crossorigin />
    <link rel="dns-prefetch" href="https://staging.vincenzoroofing.com" />
  </head>
  <body>
    <Header />

    <main id="top">
      <section class="page-hero">
        <div class="container">
          <div class="breadcrumb">
            <a href="/">Home</a><span>/</span><span>Blog &amp; Resources</span>
          </div>
          <h1>Insights, Tips &amp; <span style="color: #9cc0ff;">Industry Updates</span></h1>
          <p>Stay informed with our latest articles, expert insights, practical tips, and industry news. Explore valuable resources designed to help you make informed decisions and stay ahead with the latest trends.</p>
        </div>
      </section>

      <section class="section" style="background: var(--off);">
        <div class="container">
          
          {/* FEATURED POST */}
          {featuredPost && (() => {
            const node = featuredPost.featuredImage?.node;
            const dims = getImageDimensions(node, FEATURED_FALLBACK);
            return (
              <article
                class="featured-article-card"
                onclick={`window.location.href='/blog/${featuredPost.slug}'`}
                style="cursor: pointer;"
              >
                <div class="featured-img">
                  <img
                    src={getImageUrl(node, FALLBACK_IMG)}
                    srcset={getImageSrcSet(node)}
                    sizes="(max-width: 1024px) 100vw, 55vw"
                    width={dims.width}
                    height={dims.height}
                    alt={node?.altText || featuredPost.title}
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                  />
                </div>
                <div class="featured-body">
                  <div class="meta-tag">
                    <span class="category">Featured Guide</span>
                    <span class="read-time">Latest Article</span>
                  </div>
                  <h2>
                    <a href={`/blog/${featuredPost.slug}`}>{featuredPost.title}</a>
                  </h2>
                  <p>{cleanExcerpt(featuredPost.excerpt)}</p>
                  <div class="blog-footer" style="border: none; padding-bottom: 10px;">
                    <a href={`/blog/${featuredPost.slug}`} class="read-more-link">Read Article</a>
                  </div>
                  <div class="author-strip">
                    <div class="author-info">
                      <span>Published {formatDate(featuredPost.date)}</span>
                    </div>
                  </div>
                </div>
              </article>
            );
          })()}

          {/* GRID POSTS */}
          <div class="blog-grid" id="blog-grid">
            {visibleGridPosts.map((post, index) => {
              const node = post.featuredImage?.node;
              const dims = getImageDimensions(node, GRID_FALLBACK);
              return (
                <article
                  class="blog-card"
                  onclick={`window.location.href='/blog/${post.slug}'`}
                  style="cursor: pointer;"
                >
                  <div class="blog-media">
                    <span class="blog-cat-badge">Article</span>
                    <img
                      src={getImageUrl(node, FALLBACK_IMG)}
                      srcset={getImageSrcSet(node)}
                      sizes="(max-width: 720px) 100vw, (max-width: 1024px) 50vw, 33vw"
                      width={dims.width}
                      height={dims.height}
                      alt={node?.altText || post.title}
                      loading={index < 3 ? "eager" : "lazy"}
                      fetchpriority={index < 3 ? "high" : "auto"}
                      decoding="async"
                    />
                  </div>
                  <div class="blog-content">
                    <span class="blog-date">{formatDate(post.date)}</span>
                    <h3>
                      <a href={`/blog/${post.slug}`}>{post.title}</a>
                    </h3>
                    <p>{cleanExcerpt(post.excerpt)}</p>
                    <div class="blog-footer">
                      <a href={`/blog/${post.slug}`} class="read-more-link">Read Article</a>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>

          {/* PAGINATION / DEFERRED DATA */}
          {deferredGridPosts.length > 0 && (
            <div class="pagination" id="load-more-wrap">
              <button
                type="button"
                id="load-more-btn"
                class="btn btn-blue"
                data-batch-size="9"
              >
                Load More Articles
              </button>
            </div>
          )}

          <script
            type="application/json"
            id="more-posts-data"
            set:html={deferredJson}
          />
        </div>
      </section>
    </main>

    <Footer />

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const dataEl = document.getElementById("more-posts-data");
        const grid = document.getElementById("blog-grid");
        const btn = document.getElementById("load-more-btn");
        const wrap = document.getElementById("load-more-wrap");
        if (!dataEl || !grid || !btn || !wrap) return;

        let remaining = [];
        try {
          remaining = JSON.parse(dataEl.textContent || "[]");
        } catch {
          remaining = [];
        }

        const batchSize = parseInt(btn.dataset.batchSize || "9", 10);

        function escapeHtml(str) {
          const div = document.createElement("div");
          div.textContent = str ?? "";
          return div.innerHTML;
        }

        function renderBatch() {
          const batch = remaining.splice(0, batchSize);
          const frag = document.createDocumentFragment();

          batch.forEach((post) => {
            const article = document.createElement("article");
            article.className = "blog-card";
            article.style.cursor = "pointer";
            article.addEventListener("click", () => {
              window.location.href = `/blog/${post.slug}`;
            });

            article.innerHTML = `
              <div class="blog-media">
                <span class="blog-cat-badge">Article</span>
                <img
                  src="${escapeHtml(post.imgSrc)}"
                  ${post.imgSrcSet ? `srcset="${escapeHtml(post.imgSrcSet)}"` : ""}
                  sizes="(max-width: 720px) 100vw, (max-width: 1024px) 50vw, 33vw"
                  width="${post.imgWidth}"
                  height="${post.imgHeight}"
                  alt="${escapeHtml(post.imgAlt)}"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="blog-content">
                <span class="blog-date">${escapeHtml(post.date)}</span>
                <h3><a href="/blog/${encodeURIComponent(post.slug)}/">${escapeHtml(post.title)}</a></h3>
                <p>${escapeHtml(post.excerpt)}</p>
                <div class="blog-footer">
                  <a href="/blog/${encodeURIComponent(post.slug)}/" class="read-more-link">Read Article</a>
                </div>
              </div>
            `;

            frag.appendChild(article);
          });

          grid.appendChild(frag);

          if (remaining.length === 0) {
            wrap.remove();
          }
        }

        btn.addEventListener("click", renderBatch);
      });
    </script>

    <style is:global>
      .featured-article-card {
        background: var(--white);
        border-radius: var(--r-lg);
        border: 1px solid var(--line);
        box-shadow: var(--sh-md);
        overflow: hidden;
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 0;
        margin-bottom: 50px;
        transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
      }
      .featured-article-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--sh-lg);
      }
      .featured-img {
        position: relative;
        min-height: 340px;
        background: var(--deep);
      }
      .featured-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
      .featured-body {
        padding: 44px 40px;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
      .meta-tag {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        font-family: "Montserrat", sans-serif;
        font-size: 11.5px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--blue);
        margin-bottom: 14px;
        flex-wrap: wrap;
      }
      .meta-tag .category {
        background: var(--blue-pale);
        padding: 4px 12px;
        border-radius: 100px;
      }
      .meta-tag .read-time {
        color: var(--grey-light);
      }
      .featured-body h2 {
        font-size: clamp(22px, 2.5vw, 30px);
        line-height: 1.25;
        margin-bottom: 16px;
        transition: color 0.2s;
      }
      .featured-body h2 a:hover {
        color: var(--blue);
      }
      .featured-body p {
        color: var(--grey);
        font-size: 15px;
        margin-bottom: 24px;
        line-height: 1.65;
      }
      .author-strip {
        display: flex;
        align-items: center;
        gap: 12px;
        padding-top: 18px;
        border-top: 1px solid var(--line);
      }
      .author-info span {
        font-size: 12px;
        color: var(--grey-light);
      }
      .blog-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 28px;
        margin-bottom: 60px;
      }
      .blog-card {
        background: var(--white);
        border-radius: var(--r-lg);
        border: 1px solid var(--line);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease), border-color 0.3s;
      }
      .blog-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--sh-md);
        border-color: transparent;
      }
      .blog-media {
        position: relative;
        height: 300px;
        background: var(--off);
        overflow: hidden;
      }
      .blog-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.5s var(--ease);
      }
      .blog-card:hover .blog-media img {
        transform: scale(1.05);
      }
      .blog-cat-badge {
        font-family: "Montserrat", sans-serif;
        position: absolute;
        top: 14px;
        left: 14px;
        background: rgba(7, 31, 69, 0.85);
        backdrop-filter: blur(8px);
        color: var(--white);
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        padding: 5px 12px;
        border-radius: 100px;
      }
      .blog-content {
        padding: 26px 24px;
        display: flex;
        flex-direction: column;
        flex: 1;
      }
      .blog-date {
        font-size: 12px;
        color: var(--grey-light);
        margin-bottom: 10px;
        font-family: "Montserrat", sans-serif;
        font-weight: 600;
      }
      .blog-content h3 {
        font-size: 18px;
        line-height: 1.35;
        margin-bottom: 12px;
        font-weight: 700;
      }
      .blog-content h3 a:hover {
        color: var(--blue);
      }
      .blog-content p {
        color: var(--grey);
        font-size: 14px;
        line-height: 1.6;
        flex: 1;
        margin-bottom: 20px;
      }
      .blog-footer {
        padding-top: 16px;
        border-top: 1px solid var(--line);
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .read-more-link {
        font-family: "Montserrat", sans-serif;
        font-size: 12.5px;
        font-weight: 700;
        color: var(--blue);
        display: inline-flex;
        align-items: center;
        gap: 6px;
      }
      .read-more-link::after {
        content: "→";
        transition: transform 0.25s var(--ease);
      }
      .blog-card:hover .read-more-link::after {
        transform: translateX(4px);
      }
      .pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        margin-top: 20px;
      }
      section.page-hero h1 {
        padding-bottom: 15px;
      }
      @media (max-width: 1024px) {
        .featured-article-card {
          grid-template-columns: 1fr;
        }
        .featured-img {
          min-height: 260px;
        }
        .blog-grid {
          grid-template-columns: repeat(2, 1fr);
        }
        .featured-body {
          padding: 15px;
        }
      }
      @media (max-width: 720px) {
        .blog-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </body>
</html>