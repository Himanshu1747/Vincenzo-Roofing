<style is:global>
  .footer-col ul {
    padding: 0;
  }
  .footer-col iframe {
    width: 100%;
    border-radius: 10px;
  }
  .logo.footer {
    background: #fff;
    max-width: fit-content;
    padding: 10px;
    border-radius: 10px;
  }
  ul.social-media {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    padding-top: 20px;
}
.mycopy{
padding: 0px 15px !important;
}
@media(max-width:767px){
