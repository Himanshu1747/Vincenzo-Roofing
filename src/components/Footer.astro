---
import { queryWordPress } from "../lib/wordpress";
const today = new Date();

const PAGEJSON = `
query GetFooterAndWidgets {
  # 1. Footer Menu Query with Submenu support
  menu(id: "footer-menu", idType: SLUG) {
    menuItems(first: 100) {
      nodes {
        id
        label
        cssClasses
        url
        uri
        parentId
        target
        order
        childItems(first: 100) {
          nodes {
            id
            label
            url
            uri
            target
          }
        }
      }
    }
  }

  # 2. Header and Footer Widgets Query
  logoData
  contactData
  mapData
  copyrightData
}
`;

const pagedata = await queryWordPress(PAGEJSON);

// Extract menu nodes safely
const rawMenuItems = pagedata?.menu?.menuItems?.nodes || [];

// Filter to top-level menu items only (parentId === null)
const topLevelMenuItems = rawMenuItems.filter((item: any) => !item.parentId);

// Extract widget data safely
const logoData = pagedata?.logoData || "";
const contactData = pagedata?.contactData || "";
const mapData = pagedata?.mapData || "";
const copyrightData = pagedata?.copyrightData || "";
---

<!-- Footer -->
<footer>
  <div class="container footer-grid">
    <!-- Footer Brand Column -->
    <div class="footer-brand">
      {
        logoData ? (
          <Fragment set:html={logoData} />
        ) : (
          <div class="logo footer">
            <a href="/">
              <img
                src="/logo.png"
                alt="Vincenzo's Roofing LLC Logo"
                width="190"
                height="109"
                loading="lazy"
              />
            </a>
          </div>
          <div>
            <p>
              Licensed, insured residential and commercial roofing across New
              Hampshire. Free estimates, written warranties.
            </p>

            <!-- Social Media SVG Links -->
            <div
              class="footer-socials"
              style="display: flex; gap: 12px; margin-top: 16px;"
            >
              <!-- Facebook -->
              <a
                href="https://www.facebook.com/VincenzosRoofing"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Facebook"
                style="color: currentColor; display: inline-flex;"
              >
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
                </svg>
              </a>

              <!-- Instagram -->
              <a
                href="https://www.instagram.com/vincenzoroofing"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Instagram"
                style="color: currentColor; display: inline-flex;"
              >
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
                </svg>
              </a>

              <!-- YouTube -->
              <a
                href="https://www.youtube.com/@VincenzosRoofing"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="YouTube"
                style="color: currentColor; display: inline-flex;"
              >
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.42a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.42 8.6.42 8.6.42s6.88 0 8.6-.42a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z" />
                  <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02" />
                </svg>
              </a>

              <!-- TikTok -->
              <a
                href="https://www.tiktok.com/@vincenzos.roofing"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="TikTok"
                style="color: currentColor; display: inline-flex;"
              >
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5" />
                </svg>
              </a>
            </div>
          </div>
        )
      }
    </div>

    <!-- Company Menu Column (Fetched Dynamically from WordPress GraphQL) -->
    <div class="footer-col">
      <h5>Company</h5>
      <ul>
        {
          topLevelMenuItems.map((item: any) => (
            <li>
              <a
                href={item.uri || item.url}
                target={item.target || "_self"}
                class={item.cssClasses?.join(" ")}
              >
                {item.label}
              </a>
              {item.childItems?.nodes?.length > 0 && (
                <ul class="sub-menu">
                  {item.childItems.nodes.map((child: any) => (
                    <li>
                      <a
                        href={child.uri || child.url}
                        target={child.target || "_self"}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Contact Info Column -->
    <div class="footer-col">
      {
        contactData ? (
          <Fragment set:html={contactData} />
        ) : (
          <>
            <h5>Contact</h5>
            <ul style="list-style: none; padding: 0;">
              <!-- Phone -->
              <li style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-label="Phone"
                >
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                </svg>
                <a href="tel:+16035027080">(603) 502-7080</a>
              </li>

              <!-- Email -->
              <li style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-label="Email"
                >
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                  <polyline points="22,6 12,13 2,6" />
                </svg>
                <a href="mailto:info@vincenzosroofing.com">
                  info@vincenzosroofing.com
                </a>
              </li>

              <!-- Location -->
              <li style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-label="Location"
                >
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
                <span>43 True Rd, Seabrook, NH 03874</span>
              </li>

              <!-- Hours -->
              <li style="display: flex; align-items: center; gap: 8px;">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-label="Hours"
                >
                  <circle cx="12" cy="12" r="10" />
                  <polyline points="12 6 12 12 16 14" />
                </svg>
                <span>Mon – Sat 8 AM–4 PM · Free Roof Inspection</span>
              </li>
            </ul>
          </>
        )
      }
    </div>

    <!-- Map Column -->
    <div class="footer-col">
      {
        mapData ? (
          <Fragment set:html={mapData} />
        ) : (
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d52816169.558200695!2d-161.49265223136007!3d36.102185713814805!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x54eab584e432360b%3A0x1c3bb99243deb742!2sUnited%20States!5e0!3m2!1sen!2sin!4v1784472204006!5m2!1sen!2sin"
            width="600"
            height="250"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
          />
        )
      }
    </div>
  </div>

  <!-- Copyright Bar -->
  {
      copyrightData ? (
        <Fragment set:html={copyrightData} />
      ) : (
        <>
          <span>© 2026 Vincenzo's Roofing LLC. All rights reserved.</span>
          <span>Licensed &amp; Insured in New Hampshire</span>
        </>
      )
    }
</footer>

<style is:global>
  .footer-col ul {
    padding: 0;
  }
  .footer-col iframe {
    width: 100%;
    border-radius: 10px;
  }
  .logo.footer {
    background: #fff;
    max-width: fit-content;
    padding: 10px;
    border-radius: 10px;
  }
  ul.social-media {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    padding-top: 20px;
  }
  .mycopy {
    padding: 0px 15px !important;
  }
  .contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .contact-list li {
    display: flex;
    align-items: center;
    gap: 10px; /* Space between icon and text */
    margin-bottom: 8px;
  }

  .contact-list svg {
    flex-shrink: 0; /* Prevents icons from squishing on small screens */
  }
  ul.contact-list li {
    display: flex;
    align-items: start;
    gap: 5px;
  }
  @media (max-width: 767px) {
    .mycopy {
      padding: 10px 15px !important;
    }
  }
  iframe {
    width: 100%;
  }
</style>