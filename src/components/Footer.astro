---
import { queryWordPress } from "../lib/wordpress";
const today = new Date();

const PAGEJSON = `
query GetFooterData {
  # 1. Footer Menu Query
  menu(id: "footer-menu", idType: SLUG) {
    menuItems(first: 100) {
      nodes {
        id
        label
        cssClasses
        url
        uri
        parentId
        target
        order
      }
    }
  }

  # 2. Header Widget
  topHeaderWidgetArea

  # 3. Footer Widgets
  footerLogoWidget
  footerContactWidget
  footerMapWidget
  footerCopyrightWidget
}
`;

const pagedata = await queryWordPress(PAGEJSON);

// Extract menu nodes safely (defaults to empty array if missing)
const menuItems = pagedata?.menu?.menuItems?.nodes || [];

// Extract widget data safely
const footerLogoWidget = pagedata?.footerLogoWidget || "";
const footerContactWidget = pagedata?.footerContactWidget || "";
const footerMapWidget = pagedata?.footerMapWidget || "";
const footerCopyrightWidget = pagedata?.footerCopyrightWidget || "";
---

<!-- Footer -->
<footer>
  <div class="container footer-grid">
    <div class="footer-brand" set:html={footerLogoWidget}>
        
    </div>

    <!-- Dynamic Menu Column -->
    <div class="footer-col">
      <h5>Company</h5>
      <ul>
        {menuItems.map((item) => (
          <li key={item.id} class={item.cssClasses ? item.cssClasses.join(' ') : ''}>
            <a href={item.uri} target={item.target || '_self'}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="footer-col" set:html={footerContactWidget}>
          
      
    </div>

    <div class="footer-col">
      <div set:html={footerMapWidget}></div>

      
    </div>
  </div>

<div class="mycopy">
   <Fragment set:html={footerCopyrightWidget}/>
</div>
</footer>

