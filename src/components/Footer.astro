<style is:global>
  .footer-col ul {
    padding: 0;
  }
  .footer-col iframe {
    width: 100%;
    border-radius: 10px;
  }
  .logo.footer {
    background: #fff;
    max-width: fit-content;
    padding: 10px;
    border-radius: 10px;
  }
  ul.social-media {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    padding-top: 20px;
}
.mycopy{
padding: 0px 15px !important;
}
.contact-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.contact-list li {
  display: flex;
  align-items: center;
  gap: 10px; /* Space between icon and text */
  margin-bottom: 8px;
}

.contact-list svg {
  flex-shrink: 0; /* Prevents icons from squishing on small screens */
}
ul.contact-list li {
    display: flex;
    align-items: start;
    gap: 5px;
}
@media(max-width:767px){
  .mycopy{
padding: 10px 15px !important;
}

}
</style>
