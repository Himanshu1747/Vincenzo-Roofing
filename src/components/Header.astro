---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
import { queryWordPress } from "../lib/wordpress";

const QUERY_MENU = `
query MainMenu {
  menu(id: "main-menu", idType: SLUG) {
    menuItems(first: 100) {
      nodes {
        id
        label
        cssClasses
        url
        uri
        parentId
        target
        order
        childItems(first: 100) {
          nodes {
            label
            url
            uri
            target
          }
        }
      }
    }
  }
  siteLogo {
    sourceUrl
    altText
    mediaDetails {
      width
      height
    }
  }
}
`;

// Fetch the menu data
const data = await queryWordPress(QUERY_MENU);

// Extract topHeaderWidgetArea
const topHeaderWidgetArea = data?.topHeaderWidgetArea || null;

// Extract the menu nodes and default to an empty array if undefined
const allMenuItems = data?.menu?.menuItems?.nodes || [];

// Filter the top-level items (items that don't have a parentId)
// and sort them based on their 'order' value
const topLevelItems = allMenuItems
    .filter((item: any) => !item.parentId)
    .sort((a: any, b: any) => a.order - b.order);

// Extract Logo Data with fallbacks
const logoUrl = data?.siteLogo?.sourceUrl || "/logo.png";
const logoAlt = data?.siteLogo?.altText || "Vincenzo's Roofing LLC";
const logoWidth = data?.siteLogo?.mediaDetails?.width || "100";
const logoHeight = data?.siteLogo?.mediaDetails?.height || "auto";
---

<!-- Header -->
<header id="siteHeader">
  <!-- Top Utility Bar -->
  <div class="top-strip">
    <div id="custom_html-2" class="widget_text widget custom-widget widget_custom_html">
      <div class="textwidget custom-html-widget">
        <div class="container">
          <div class="left">Licensed &amp; Insured · Serving all of New Hampshire</div>
          <div>
            <span class="pulse"></span>24/7 Emergency Line: 
            <a href="tel:+1 (603) 502-7080"> (603) 502-7080</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Navigation -->
  <div class="nav-wrap">
    <div class="header-logo">
      <a href="/" class="logo" aria-label="Vincenzo's Roofing LLC home">
        <img
          src="/logonew.png"
          alt="Vincenzo's Roofing LLC"
          width="130"
          height="47"
          fetchpriority="high"
          loading="eager"
          decoding="sync"
        />
      </a>
    </div>

    <nav class="primary" aria-label="Primary">
      <a href="/" class="active">Home</a>
      <a href="/about">About</a>
      
      <!-- Dropdown -->
      <div class="nav-dropdown">
        <a href="#">
          Service
          <svg class="nav-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6">
            <path d="M6 9l6 6 6-6"></path>
          </svg>
        </a>
        <div class="nav-dropdown-menu">
          <a href="/service/roof-replacement">Roof Replacement</a>
          <a href="/service/roof-repair">Roof Repair</a>
          <a href="/service/storm-emergency">Storm Emergency</a>
          <a href="/service/roof-inspection">Roof Inspection</a>
          <a href="/service/asphalt-shingle-roofing">Asphalt Shingle Roofing</a>
          <a href="/service/metal-roofing">Metal Roofing</a>
          <a href="/service/commercial-flat-roofing">Commercial &amp; Flat Roofing</a>
          <a href="/service/siding-installation-replacement">Siding Installation &amp; Replacement</a>
          <a href="/service/gutters-decks">Gutters &amp; Decks</a>
        </div>
      </div>

      <a href="/blog">Blog</a>
      <a href="/contact/">Contact Us</a>
    </nav>

    <!-- Header Actions -->
    <div class="header-ctas">
      <a href="tel:+1 (603) 502-7080" class="header-phone">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
          <path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3 19.5 19.5 0 01-6-6 19.8 19.8 0 01-3-8.7A2 2 0 014.1 2h3a2 2 0 012 1.7c.1.9.3 1.8.6 2.7a2 2 0 01-.5 2.1L8 9.9a16 16 0 006 6l1.4-1.4a2 2 0 012.1-.5c.9.3 1.8.5 2.7.6a2 2 0 011.8 2.3z"></path>
        </svg>
        <span>(603) 502-7080</span>
      </a>
      <a href="/free-estimate" class="btn btn-blue">Free Estimate</a>
      <button class="menu-toggle" id="menuToggle" aria-label="Open menu" aria-expanded="false">
        <span></span>
      </button>
    </div>
  </div>
</header>

<div class="margin-top"></div>

<!-- Mobile Navigation Drawer -->
<div class="mobile-panel" id="mobilePanel">
  <a href="/" class="mp-link">Home</a>
  <a href="/about" class="mp-link">About</a>
  
  <div class="mp-link-group">
    <div class="data-dropdowns">
      <a href="#" class="mp-toggle" aria-expanded="false">
        <span>Service</span>
      </a>
      <div class="dropdown-opens">
        <svg class="mp-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
          <path d="M6 9l6 6 6-6"></path>
        </svg>
      </div>
    </div>
    <div class="mp-submenu">
      <a href="/service/roof-replacement" class="mp-sublink">Roof Replacement</a>
      <a href="/service/roof-repair" class="mp-sublink">Roof Repair</a>
      <a href="/service/storm-emergency" class="mp-sublink">Storm Emergency</a>
      <a href="/service/roof-inspection" class="mp-sublink">Roof Inspection</a>
      <a href="/service/asphalt-shingle-roofing" class="mp-sublink">Asphalt Shingle Roofing</a>
      <a href="/service/metal-roofing" class="mp-sublink">Metal Roofing</a>
      <a href="/service/commercial-flat-roofing" class="mp-sublink">Commercial &amp; Flat Roofing</a>
      <a href="/service/siding-installation-replacement" class="mp-sublink">Siding Installation &amp; Replacement</a>
      <a href="/service/gutters-decks" class="mp-sublink">Gutters &amp; Decks</a>
    </div>
  </div>

  <a href="/blog" class="mp-link">Blog</a>
  <a href="/contact/" class="mp-link">Contact Us</a>

  <div class="mp-ctas">
    <a href="tel:+1 (603) 502-7080" class="btn btn-ghost-w">Call (603) 502-7080</a>
    <a href="/free-estimate" class="btn btn-blue">Get a Free Estimate</a>
  </div>
</div>
<style>
    .mp-link-group a {
        max-width: fit-content;
        width: 100%;
    }
    .data-dropdowns {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
    }
    .mp-link-group .mp-submenu a {
        max-width: 100% !important;
        width: 100%;
        display: block;
    }
</style>

<script>
    /* ---------- Dynamic Header Margin & Scroll handling ---------- */
    const hdr = document.getElementById("siteHeader");
    const marginTopDiv = document.querySelector(".margin-top") as HTMLElement | null;
    const btn = document.getElementById("menuToggle");
    const panel = document.getElementById("mobilePanel");

    // Function to synchronize the height
    const updateHeaderSpacing = () => {
        if (hdr && marginTopDiv) {
            const headerHeight = hdr.offsetHeight;
            marginTopDiv.style.marginTop = `${headerHeight}px`;
        }
    };

    // Run on initial load
    updateHeaderSpacing();

    // Recalculate on window resize
    window.addEventListener("resize", updateHeaderSpacing);

    // Recalculate if images inside the header load later
    window.addEventListener("load", updateHeaderSpacing);

    /* ---------- Header shadow on scroll ---------- */
    if (hdr) {
        const onScroll = () =>
            hdr.classList.toggle("scrolled", window.scrollY > 8);
        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });
    }

    /* ---------- Global Event Delegation ---------- */
    document.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;

        // 1. Mobile menu toggle button
        if (btn && (target === btn || btn.contains(target))) {
            const isOpen = panel?.classList.toggle("open");
            btn.classList.toggle("active", isOpen);
            btn.setAttribute("aria-expanded", String(isOpen));
            document.body.style.overflow = isOpen ? "hidden" : "";
            return;
        }

        // 2. Click-to-close for active mobile links
        if (target.closest("a.mp-link, a.mp-sublink")) {
            panel?.classList.remove("open");
            btn?.classList.remove("active");
            btn?.setAttribute("aria-expanded", "false");
            document.body.style.overflow = "";
            return;
        }

        // 3. Mobile Accordions
        const dropdownOpens = target.closest(".dropdown-opens");
        const mpToggle = target.closest(".mp-toggle");

        if (dropdownOpens || mpToggle) {
            const parentGroup = target.closest(".mp-link-group");
            if (parentGroup) {
                const toggleBtn = parentGroup.querySelector(".mp-toggle");
                const submenu = parentGroup.querySelector(".mp-submenu");

                if (mpToggle) {
                    const href = mpToggle.getAttribute("href");
                    if (!href || href === "#") e.preventDefault();
                } else if (dropdownOpens) {
                    e.preventDefault();
                }

                if (submenu && submenu.classList.contains("mp-submenu")) {
                    const isOpen = submenu.classList.toggle("open");
                    toggleBtn?.setAttribute("aria-expanded", String(isOpen));
                }
            }
            return;
        }

        // 4. Desktop dropdown click-outside fallback
        document.querySelectorAll(".nav-dropdown").forEach((dd) => {
            if (!dd.contains(target)) dd.classList.remove("open");
        });
    });
</script>